@model global::Appointment
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Book Appointment";
}

<div class="ht-dashboard-container">
    <!-- Breadcrumb & Back Links -->
    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <a asp-controller="Client" asp-action="index" class="ht-card-link-action p-0" id="linkBookBackToDashboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Dashboard</span>
        </a>
        <span class="text-muted" aria-hidden="true">&bull;</span>
        <a asp-controller="Appointment" asp-action="index" class="ht-card-link-action p-0" id="linkBookBackToAppointments">
            <span>Back to Appointments</span>
        </a>
    </div>

    <!-- Header Section -->
    <div class="ht-welcome-section mb-4">
        <h1 class="ht-welcome-title">Book an Appointment</h1>
        <p class="ht-welcome-subtitle">Request a 1-on-1 consultation session with a certified health and fitness trainer.</p>
    </div>

    <!-- Main Booking Card -->
    <div class="row g-4">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            <div class="ht-card">
                <div class="ht-card-header-flex mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0">Consultation Details</h2>
                            <p class="ht-card-subtitle mb-0">Select your preferred date, time and consultation topic</p>
                        </div>
                    </div>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="ht-validation-summary mb-3" role="alert"></div>

                <!-- Booking Form -->
                <form asp-controller="Appointment" asp-action="book" method="post" id="appointmentBookForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <!-- Date & Time Input -->
                        <div class="col-12 col-sm-6">
                            <div class="ht-form-group mb-0">
                                <label asp-for="dateTime" class="ht-label">Consultation Date &amp; Time <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                    </span>
                                    <input asp-for="dateTime"
                                           type="datetime-local"
                                           class="ht-input"
                                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                           required
                                           aria-required="true"
                                           id="appointment-datetime-input" />
                                </div>
                                <span asp-validation-for="dateTime" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Trainer Selection -->
                        <div class="col-12 col-sm-6">
                            <div class="ht-form-group mb-0">
                                <label asp-for="trainerId" class="ht-label">Select Trainer <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                    </span>
                                    <select asp-for="trainerId" class="ht-input form-select border-0 ps-0" required aria-required="true" id="appointment-trainer-input">
                                        <option value="1">Marcus Vance (Fitness &amp; Bodybuilding)</option>
                                        <option value="2">Kasun Fernando (Strength &amp; Conditioning)</option>
                                        <option value="3">Dhammika Perera (Nutrition &amp; Weight Loss)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="trainerId" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Consultation Notes / Goals -->
                        <div class="col-12">
                            <div class="ht-form-group mb-0">
                                <label asp-for="notes" class="ht-label">Consultation Notes / Focus Areas <span class="text-muted small fw-normal">(Optional)</span></label>
                                <textarea asp-for="notes"
                                          class="ht-input py-2"
                                          rows="4"
                                          style="height: auto; min-height: 96px;"
                                          placeholder="e.g., Routine review, personalized nutrition plan discussion, target weight check-in..."
                                          id="appointment-notes-input"></textarea>
                                <span asp-validation-for="notes" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- System Workflow Notice -->
                        <div class="col-12">
                            <div class="ht-workout-notice d-flex align-items-start gap-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-primary mt-1">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <div class="small text-muted">
                                    <strong>Appointment Confirmation Workflow:</strong>
                                    Upon submission, your appointment request is placed in <em>Pending</em> status. Your assigned trainer will review availability and confirm your booking.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-3 border-top">
                        <a asp-controller="Appointment" asp-action="index" class="btn btn-outline-secondary px-4 py-2" id="btnCancelBook">
                            Cancel
                        </a>
                        <button type="submit" class="ht-btn-submit px-4" id="btnSubmitAppointment">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Request Appointment</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
