<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack Admin Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthTrack.styles.css" asp-append-version="true" />
</head>
<body class="ht-portal-body">
    <a href="#portal-main-content" class="skip-link">Skip to main content</a>

    <div class="ht-portal-shell">
        <!-- Sidebar Navigation -->
        <aside class="ht-portal-sidebar" id="portalSidebar" aria-label="Admin Portal Navigation">
            <!-- Sidebar Header / Brand -->
            <div class="ht-sidebar-header">
                <a class="ht-sidebar-brand" asp-controller="Admin" asp-action="index">
                    <span class="ht-sidebar-badge" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                            <path d="M3.22 12H9.5l1.5-3 2 6 1.5-3h6.28"></path>
                        </svg>
                    </span>
                    <div class="ht-brand-titles">
                        <span class="ht-brand-main">HealthTrack</span>
                        <span class="ht-brand-sub ht-brand-sub-trainer">ADMIN PORTAL</span>
                    </div>
                </a>
                <button type="button" class="btn-close d-lg-none" id="closeSidebarBtn" aria-label="Close navigation"></button>
            </div>

            @{
                var routeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var routeAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                bool isAdminDashboard = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(routeAct, "index", StringComparison.OrdinalIgnoreCase);

                bool isUserManagement = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                        (string.Equals(routeAct, "users", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(routeAct, "createTrainer", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(routeAct, "assignTrainers", StringComparison.OrdinalIgnoreCase));

                bool isAdminReports = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                      string.Equals(routeAct, "reports", StringComparison.OrdinalIgnoreCase);

                bool isNotifications = string.Equals(routeCtrl, "Notification", StringComparison.OrdinalIgnoreCase);
            }
            <nav class="ht-sidebar-menu">
                <!-- 1. Dashboard -->
                <a asp-controller="Admin" asp-action="index"
                   class="ht-nav-item @(isAdminDashboard ? "active" : "")"
                   aria-current="@(isAdminDashboard ? "page" : null)">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                        </svg>
                    </span>
                    <span>Dashboard</span>
                </a>

                <!-- 2. User Management -->
                <a asp-controller="Admin" asp-action="users"
                   class="ht-nav-item @(isUserManagement ? "active" : "")"
                   aria-current="@(isUserManagement ? "page" : null)">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                    <span>User Management</span>
                </a>

                <!-- 3. Reports -->
                <a asp-controller="Admin" asp-action="reports"
                   class="ht-nav-item @(isAdminReports ? "active" : "")"
                   aria-current="@(isAdminReports ? "page" : null)">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </span>
                    <span>Reports</span>
                </a>
            </nav>

            <!-- Bottom Navigation: Sign Out -->
            <div class="ht-sidebar-footer">
                <form asp-controller="Account" asp-action="logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ht-nav-item ht-nav-signout w-100">
                        <span class="ht-nav-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </span>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="ht-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

        <!-- Main Column -->
        <div class="ht-portal-main">
            <header class="ht-portal-topbar">
                <div class="ht-topbar-left">
                    <button type="button" class="ht-mobile-toggle d-lg-none" id="openSidebarBtn" aria-label="Open navigation menu">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="ht-topbar-right">
                    <a asp-controller="Notification" asp-action="index" class="ht-topbar-btn position-relative @(isNotifications ? "active" : "")" aria-label="Notifications">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                        </svg>
                        <span class="ht-notification-dot" aria-hidden="true"></span>
                    </a>

                    <div class="ht-topbar-profile">
                        <div class="ht-profile-avatar">
                            @(ViewData["AdminInitials"] ?? "AD")
                        </div>
                        <div class="ht-profile-details">
                            <span class="ht-profile-name">@(ViewData["AdminName"] ?? "Administrator")</span>
                            <span class="ht-profile-role">Admin</span>
                        </div>
                    </div>
                </div>
            </header>

            <main id="portal-main-content" role="main" class="ht-portal-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>