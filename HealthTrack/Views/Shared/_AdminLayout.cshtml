<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack Admin Portal</title>

    <!-- Typography: Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Core Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthTrack.styles.css" asp-append-version="true" />
</head>
<body class="ht-portal-body">
    <!-- Accessible Skip Link -->
    <a href="#portal-main-content" class="skip-link">Skip to main content</a>

    <div class="ht-portal-shell">
        <!-- Sidebar Navigation (255px wide desktop) -->
        <aside class="ht-portal-sidebar" id="portalSidebar" aria-label="Admin Portal Navigation">
            <!-- Sidebar Header / Brand -->
            <div class="ht-sidebar-header">
                <a class="ht-sidebar-brand" asp-controller="Admin" asp-action="index">
                    <span class="ht-sidebar-badge" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                            <path d="M3.22 12H9.5l1.5-3 2 6 1.5-3h6.28"></path>
                        </svg>
                    </span>
                    <div class="ht-brand-titles">
                        <span class="ht-brand-main">HealthTrack</span>
                        <span class="ht-brand-sub ht-brand-sub-admin">ADMIN PORTAL</span>
                    </div>
                </a>
                <button type="button" class="btn-close d-lg-none" id="closeSidebarBtn" aria-label="Close navigation"></button>
            </div>

            <!-- Primary Navigation Links: Strictly the 4 Coursework Administrator Responsibilities -->
            @{
                var routeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var routeAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                bool isDashboard = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                   (string.Equals(routeAct, "index", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(routeAct));

                bool isUsers = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                               string.Equals(routeAct, "users", StringComparison.OrdinalIgnoreCase);

                bool isTrainerAssignments = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                            string.Equals(routeAct, "trainerassignments", StringComparison.OrdinalIgnoreCase);

                bool isReports = string.Equals(routeCtrl, "Admin", StringComparison.OrdinalIgnoreCase) &&
                                 string.Equals(routeAct, "reports", StringComparison.OrdinalIgnoreCase);
            }
            <nav class="ht-sidebar-menu">
                <!-- 1. Dashboard -->
                <a asp-controller="Admin" asp-action="index" class="ht-nav-item @(isDashboard ? "active" : "")" aria-current="@(isDashboard ? "page" : null)">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                        </svg>
                    </span>
                    <span>Dashboard</span>
                </a>

                <!-- 2. User Management -->
                <a asp-controller="Admin" asp-action="users" class="ht-nav-item @(isUsers ? "active" : "")" aria-current="@(isUsers ? "page" : null)">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                    <span>User Management</span>
                </a>

                <!-- 3. Trainer Assignments (Links to preview file to prevent unhandled 404 while backend action is pending) -->
                <a href="~/admin-trainer-assignments-preview.html" class="ht-nav-item @(isTrainerAssignments ? "active" : "")" aria-current="@(isTrainerAssignments ? "page" : null)" title="Trainer Assignments">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                    <span>Trainer Assignments</span>
                </a>

                <!-- 4. Reports & Activity (Links to preview file to prevent unhandled 404 while backend action is pending) -->
                <a href="~/admin-reports-preview.html" class="ht-nav-item @(isReports ? "active" : "")" aria-current="@(isReports ? "page" : null)" title="Reports & Activity">
                    <span class="ht-nav-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </span>
                    <span>Reports & Activity</span>
                </a>
            </nav>

            <!-- Bottom Navigation: Admin Identity & Sign Out -->
            <div class="ht-sidebar-footer">
                <div class="px-2 py-1 mb-1 text-muted small d-flex align-items-center gap-2">
                    <span class="ht-status-dot-active" aria-hidden="true"></span>
                    <span>Admin Active</span>
                </div>

                <form asp-controller="Account" asp-action="logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ht-nav-item ht-nav-signout w-100">
                        <span class="ht-nav-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </span>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Backdrop for mobile sidebar drawer -->
        <div class="ht-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

        <!-- Main Column -->
        <div class="ht-portal-main">
            <!-- Topbar (White bar with status badge & admin profile on right) -->
            <header class="ht-portal-topbar">
                <div class="ht-topbar-left">
                    <button type="button" class="ht-mobile-toggle d-lg-none" id="openSidebarBtn" aria-label="Open navigation menu">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d6e5a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="d-none d-sm-inline">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                            <path d="M3.22 12H9.5l1.5-3 2 6 1.5-3h6.28"></path>
                        </svg>
                        <span class="fw-semibold text-dark" style="font-size: 0.95rem;">Admin Portal</span>
                    </div>
                </div>

                <div class="ht-topbar-right">
                    <!-- Environment Pill -->
                    <span class="ht-topbar-env-pill">
                        <span class="ht-status-dot-active" aria-hidden="true"></span>
                        <span>System RBAC Active</span>
                    </span>

                    <!-- Admin Profile Badge -->
                    <div class="ht-topbar-profile">
                        <div class="ht-profile-avatar" style="background-color: #095c4d;">
                            AD
                        </div>
                        <div class="ht-profile-details">
                            <span class="ht-profile-name">@(User.Identity?.Name ?? "admin@healthtrack.com")</span>
                            <span class="ht-profile-role">Administrator</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Body Content -->
            <main id="portal-main-content" role="main" class="ht-portal-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
