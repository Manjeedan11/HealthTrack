                                    <circle cx="100" cy="100" r="80" fill="@Model.PopularDietPlans[0].Color" />
                                }
                                else
                                {
                                    double startAngle = 0;
                                    foreach (var item in Model.PopularDietPlans)
                                    {
                                        var pct = (double)item.UsageCount / dietTotal;
                                        var span = pct * 360;
                                        var endAngle = startAngle + span;
                                        var path = PieSlicePath(100, 100, 80, startAngle, endAngle);
                                        <path d="@path" fill="@item.Color" stroke="#ffffff" stroke-width="2"></path>
                                        startAngle = endAngle;
                                    }
                                }
                                <circle cx="100" cy="100" r="45" fill="#ffffff" />
