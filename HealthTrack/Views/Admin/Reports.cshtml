                                @Html.Raw("<text x=\"100\" y=\"114\" text-anchor=\"middle\" font-size=\"10\" fill=\"#64748b\">total logs</text>")
                            </svg>
                            <div class="chart-legend">
                                @foreach (var item in Model.PopularDietPlans)
                                {
                                    var pct = dietTotal > 0 ? (double)item.UsageCount / dietTotal * 100 : 0;
                                    <div class="chart-legend-item">
                                        <span class="chart-legend-dot" style="background: @item.Color;"></span>
                                        <span>@item.Name — @item.UsageCount (@pct.ToString("F0", inv)%)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-chart">No diet plan logs in this date range.</div>
                    }
                </section>
            </div>
        </div>
    }

</div>