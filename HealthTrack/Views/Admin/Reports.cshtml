@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports & Activity";
}

<div class="ht-dashboard-container">
    <!-- Header -->
    <div class="ht-welcome-section mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h1 class="ht-welcome-title">Administrative Reports & System Activity</h1>
                <p class="ht-welcome-subtitle">Comprehensive analytics on platform usage, client progress, trainer engagement, and routine allocations.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="alert('Export Notice:\n\nAutomated CSV and PDF reporting endpoints are pending backend implementation. This UI demonstrates the complete reporting metrics.');">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                    <span>Export Summary (Pending Backend API)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Auditability Handover Notice -->
    <div class="ht-admin-notice-banner notice-info" role="alert">
        <div class="ht-notice-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
        </div>
        <div class="ht-notice-content">
            <h4>Coursework Auditability & Accountability Gap</h4>
            <p>
                <strong>Inspection Finding:</strong> The non-functional requirements (Table 2) mandate recording critical administrative actions, logins, and status changes for accountability.
                The current database schema does not have a dedicated <code>AuditLog</code> table or service; system activity below reflects actual entity operations (notifications, appointments, and registrations).
                <strong>Recommendation for Backend Developer:</strong> Implement an <code>AuditLog</code> entity (Action, Timestamp, UserId, Details) to record significant Admin operations.
            </p>
        </div>
    </div>

    <!-- SECTION 1: System Usage Totals -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold text-dark mb-0">1. System Usage & Entity Statistics</h2>
            <span class="text-muted small">Aggregated Platform Totals</span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-3 col-sm-6">
                <div class="ht-card p-3">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Workout Plans</div>
                    <div class="fs-4 fw-bold text-dark">12</div>
                    <div class="text-muted small mt-1">42 associated exercises</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="ht-card p-3">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Diet Plans</div>
                    <div class="fs-4 fw-bold text-dark">8</div>
                    <div class="text-muted small mt-1">26 scheduled meals</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="ht-card p-3">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Health Logs</div>
                    <div class="fs-4 fw-bold text-dark">47</div>
                    <div class="text-muted small mt-1">Weight & BMI data points</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="ht-card p-3">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Consultations</div>
                    <div class="fs-4 fw-bold text-dark">19</div>
                    <div class="text-muted small mt-1">Appointments scheduled</div>
                </div>
            </div>
        </div>

        <div class="ht-card p-4">
            <div class="fw-bold text-dark mb-2">Entity Distribution Across Storage</div>
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">Client Profiles</span>
                        <span class="fw-bold text-dark">6 profiles</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">Trainer Profiles</span>
                        <span class="fw-bold text-dark">3 profiles</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">Administrator Accounts</span>
                        <span class="fw-bold text-dark">1 account</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">Feedback Messages</span>
                        <span class="fw-bold text-dark">14 entries</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">System Notifications</span>
                        <span class="fw-bold text-dark">38 delivered</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <span class="text-muted">Authentication Provider</span>
                        <span class="fw-bold text-dark">ASP.NET Core Identity</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: Client Performance Trends (Privacy-Preserving Aggregates) -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h5 fw-bold text-dark mb-0">2. Client Performance & Progress Overview</h2>
                <span class="text-muted small">Aggregated health metric coverage without exposing personal medical records</span>
            </div>
            <span class="badge bg-light text-dark border">Privacy Preserving</span>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="ht-card h-100 p-4">
                    <div class="fw-bold text-dark mb-3">Measurement Logging Compliance</div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small text-muted">Clients with &gt; 1 Logged Metric</span>
                        <span class="small fw-bold text-dark">83% (5 of 6 clients)</span>
                    </div>
                    <div class="ht-progress-track mb-4">
                        <div class="ht-progress-fill" style="width: 83%;"></div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small text-muted">Clients with Weekly Logs (Last 14 Days)</span>
                        <span class="small fw-bold text-dark">67% (4 of 6 clients)</span>
                    </div>
                    <div class="ht-progress-track mb-3">
                        <div class="ht-progress-fill" style="width: 67%;"></div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border small text-muted mt-3">
                        <strong class="text-dark">Privacy Note:</strong> In compliance with the non-functional data protection standards, administrators review aggregate progress trends rather than individual client weight sheets.
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="ht-card h-100 p-4">
                    <div class="fw-bold text-dark mb-3">Aggregated BMI Distribution</div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Normal Range (18.5 – 24.9)</span>
                        <span class="fw-bold text-dark">50% (3 clients)</span>
                    </div>
                    <div class="ht-progress-track mb-3">
                        <div class="ht-progress-fill" style="width: 50%; background-color: #10b981;"></div>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Overweight (25.0 – 29.9)</span>
                        <span class="fw-bold text-dark">33% (2 clients)</span>
                    </div>
                    <div class="ht-progress-track mb-3">
                        <div class="ht-progress-fill" style="width: 33%; background-color: #f59e0b;"></div>
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Underweight (&lt; 18.5)</span>
                        <span class="fw-bold text-dark">17% (1 client)</span>
                    </div>
                    <div class="ht-progress-track mb-3">
                        <div class="ht-progress-fill" style="width: 17%; background-color: #6366f1;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 3: Trainer Engagement Breakdown -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold text-dark mb-0">3. Trainer Engagement & Activity Breakdown</h2>
            <span class="text-muted small">Workouts Created, Consultations Hosted, & Feedback Delivered</span>
        </div>

        <div class="ht-admin-table-card">
            <div class="table-responsive">
                <table class="table ht-admin-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Trainer Name</th>
                            <th scope="col">Specialization</th>
                            <th scope="col" class="text-center">Assigned Clients</th>
                            <th scope="col" class="text-center">Workout Plans</th>
                            <th scope="col" class="text-center">Diet Plans</th>
                            <th scope="col" class="text-center">Appointments</th>
                            <th scope="col" class="text-center">Feedback Sent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ht-user-avatar" style="background:#fef3c7; color:#b45309;">MV</div>
                                    <span class="fw-bold text-dark">Marcus Vance</span>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Strength & Conditioning</span></td>
                            <td class="text-center fw-semibold">2</td>
                            <td class="text-center">6</td>
                            <td class="text-center">4</td>
                            <td class="text-center">9</td>
                            <td class="text-center">8</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ht-user-avatar" style="background:#fef3c7; color:#b45309;">ER</div>
                                    <span class="fw-bold text-dark">Elena Rostova</span>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Weight Loss & Cardio</span></td>
                            <td class="text-center fw-semibold">1</td>
                            <td class="text-center">4</td>
                            <td class="text-center">3</td>
                            <td class="text-center">6</td>
                            <td class="text-center">4</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ht-user-avatar" style="background:#fef3c7; color:#b45309;">LB</div>
                                    <span class="fw-bold text-dark">Liam Bennett</span>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border">Rehabilitation & Mobility</span></td>
                            <td class="text-center fw-semibold">1</td>
                            <td class="text-center">2</td>
                            <td class="text-center">1</td>
                            <td class="text-center">4</td>
                            <td class="text-center">2</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SECTION 4: Routine Overview (Popular Routines by Plan Allocations) -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h5 fw-bold text-dark mb-0">4. Routine Popularity Overview</h2>
                <span class="text-muted small">Most frequently allocated workout and nutrition plans across client profiles</span>
            </div>
            <span class="badge bg-light text-muted border">Plan Allocation Stats</span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="ht-card p-4">
                    <div class="fw-bold text-dark mb-3">Top Workout Routines by Assignment</div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">Upper Body Strength Foundation</div>
                            <span class="text-muted small">5 exercises &bull; 45 mins</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">4 clients</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">HIIT Cardio & Core Blast</div>
                            <span class="text-muted small">6 exercises &bull; 30 mins</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">3 clients</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">Lower Body Mobility & Stretch</div>
                            <span class="text-muted small">4 exercises &bull; 25 mins</span>
                        </div>
                        <span class="badge bg-light text-dark border">2 clients</span>
                    </div>
                    <div class="mt-3 small text-muted">
                        <em>Note: Statistics reflect routine assignment counts created by trainers for clients, not client self-logged workout completions.</em>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ht-card p-4">
                    <div class="fw-bold text-dark mb-3">Top Diet Plans by Assignment</div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">High-Protein Lean Muscle Meal Plan</div>
                            <span class="text-muted small">4 meals &bull; 2,200 kcal</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">3 clients</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">Caloric Deficit Balanced Diet</div>
                            <span class="text-muted small">3 meals &bull; 1,800 kcal</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">3 clients</span>
                    </div>
                    <div class="ht-stat-breakdown-row">
                        <div>
                            <div class="fw-semibold text-dark">Endurance Hydration & Recovery Plan</div>
                            <span class="text-muted small">4 meals &bull; 2,500 kcal</span>
                        </div>
                        <span class="badge bg-light text-dark border">2 clients</span>
                    </div>
                    <div class="mt-3 small text-muted">
                        <em>Note: Represents nutrition guidelines structured by trainers via DietPlan & Meal entities.</em>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 5: Recent Platform Activity & Notification Stream -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold text-dark mb-0">5. Recent Activity & System Notifications</h2>
            <span class="text-muted small">Operational Event Stream</span>
        </div>

        <div class="ht-card p-4">
            <div class="ht-activity-timeline">
                <div class="ht-timeline-item">
                    <div class="ht-timeline-dot"></div>
                    <span class="ht-timeline-time">Today, 14:30</span>
