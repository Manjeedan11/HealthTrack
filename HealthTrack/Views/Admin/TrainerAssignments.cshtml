<!-- Trainer Assignment Modal (Preview Interface) -->
<div class="ht-modal-backdrop" id="htAssignModal" role="dialog" aria-modal="true" aria-labelledby="assignModalTitle">
    <div class="ht-modal-card">
        <div class="ht-modal-header">
            <h2 class="ht-modal-title" id="assignModalTitle">Assign Trainer to Client</h2>
            <button type="button" class="btn-close" id="assignModalClose" aria-label="Close dialog"></button>
        </div>
        <div class="ht-modal-body">
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Client</label>
                <div class="fw-bold text-dark fs-6" id="assignClientName">Sarah Jenkins</div>
                <input type="hidden" id="assignClientId" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Current Assigned Trainer</label>
                <div class="text-dark" id="assignCurrentTrainer">Marcus Vance</div>
            </div>

            <div class="mb-3">
                <label for="assignTrainerSelect" class="form-label fw-bold text-dark">Select New Trainer</label>
                <select class="form-select" id="assignTrainerSelect">
                    <option value="1">Marcus Vance — Strength & Conditioning (2 active clients)</option>
                    <option value="2">Elena Rostova — Weight Loss & Cardio (1 active client)</option>
                    <option value="3">Liam Bennett — Rehabilitation & Mobility (1 active client)</option>
                </select>
            </div>

            <div class="p-3 bg-light rounded-3 border small text-muted">
                <div class="fw-bold text-dark mb-1">Database Schema Integration Notice</div>
                <div>Persisting direct trainer assignments requires adding a nullable <code>Client.trainerId</code> foreign key to the database schema. When confirmed by the backend developer, this modal will submit to <code>POST /Admin/AssignTrainer</code>.</div>
            </div>
        </div>
        <div class="ht-modal-footer">
            <button type="button" class="btn btn-outline-secondary" id="assignModalCancel">Cancel</button>
            <button type="button" class="btn btn-primary" id="assignSubmitBtn" style="background-color: #095c4d; border-color: #095c4d;">
                Confirm Assignment (Preview)
            </button>
        </div>
    </div>
</div>
