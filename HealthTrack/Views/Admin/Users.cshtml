@model IEnumerable<User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Account Management";

    var userList = Model?.ToList() ?? new List<User>();
    int totalCount = userList.Count;
    int clientCount = userList.Count(u => string.Equals(u.role, "Client", StringComparison.OrdinalIgnoreCase));
    int trainerCount = userList.Count(u => string.Equals(u.role, "Trainer", StringComparison.OrdinalIgnoreCase));
    int adminCount = userList.Count(u => string.Equals(u.role, "Admin", StringComparison.OrdinalIgnoreCase));
}

<div class="ht-dashboard-container">
    <!-- Header -->
    <div class="ht-welcome-section mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h1 class="ht-welcome-title">User Account & Role Management</h1>
                <p class="ht-welcome-subtitle">Search, filter, inspect accounts and manage system role assignments.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border px-3 py-2 fs-7">
                    <span class="fw-bold" id="visibleUsersCount">@totalCount</span> of @totalCount Accounts Loaded
                </span>
            </div>
        </div>
    </div>

    <!-- Backend Handover Notice: Role-Change Integration Status -->
    <div class="ht-admin-notice-banner notice-warning" role="alert">
        <div class="ht-notice-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <div class="ht-notice-content">
            <h4>Backend Handover Contract: User Role Management</h4>
            <p>
                The UI displays live Identity accounts from <code>AdminController.users()</code>. Role modification UI is integration-ready below.
                Submissions are safely prevented from claiming fake persistence until the backend developer implements <code>POST /Admin/UpdateUserRole</code>
                with <code>UserManager&lt;User&gt;</code>, role claims sync, self-demotion prevention, and profile record creation.
            </p>
        </div>
    </div>

    <!-- Search & Filter Controls Toolbar -->
    <div class="ht-search-filter-bar">
        <div class="ht-search-box">
            <span class="ht-search-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            <input type="text" id="userSearchInput" class="ht-search-input" placeholder="Search by email, role, or user ID..." aria-label="Search users" />
        </div>

        <div class="ht-filter-pills" role="group" aria-label="Role Filter Tabs">
            <button type="button" class="ht-filter-pill active" data-role-filter="all">
                <span>All Roles</span>
                <span class="ht-pill-count">@totalCount</span>
            </button>
            <button type="button" class="ht-filter-pill" data-role-filter="client">
                <span>Clients</span>
                <span class="ht-pill-count">@clientCount</span>
            </button>
            <button type="button" class="ht-filter-pill" data-role-filter="trainer">
                <span>Trainers</span>
                <span class="ht-pill-count">@trainerCount</span>
            </button>
            <button type="button" class="ht-filter-pill" data-role-filter="admin">
                <span>Admins</span>
                <span class="ht-pill-count">@adminCount</span>
            </button>
        </div>
    </div>

    <!-- User Accounts Table -->
    <div class="ht-admin-table-card">
        <div class="table-responsive">
            <table class="table ht-admin-table align-middle" id="userAccountsTable">
                <thead>
                    <tr>
                        <th scope="col" style="width: 320px;">Account / Email</th>
                        <th scope="col">User ID</th>
                        <th scope="col">Assigned Role</th>
                        <th scope="col">Account Status</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!userList.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mb-2 text-secondary">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <div>No user records currently present in the database.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in userList)
                        {
                            var roleClass = "ht-role-client";
                            var normalizedRole = (user.role ?? "Client").Trim();
                            if (string.Equals(normalizedRole, "Admin", StringComparison.OrdinalIgnoreCase)) roleClass = "ht-role-admin";
                            else if (string.Equals(normalizedRole, "Trainer", StringComparison.OrdinalIgnoreCase)) roleClass = "ht-role-trainer";

                            var emailInitial = string.IsNullOrEmpty(user.Email) ? "U" : user.Email.Substring(0, 1).ToUpperInvariant();

                            <tr class="ht-user-row" data-email="@user.Email" data-role="@normalizedRole" data-id="@user.Id">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="ht-user-avatar" aria-hidden="true">
                                            @emailInitial
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(user.Email ?? "No Email Registered")</div>
                                            <div class="text-muted small">Username: @user.UserName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code class="text-secondary small">@(user.Id.Length > 16 ? user.Id.Substring(0, 16) + "..." : user.Id)</code>
                                </td>
                                <td>
                                    <span class="ht-role-badge @roleClass">
                                        @normalizedRole
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="small text-muted d-flex align-items-center gap-1">
                                            <span class="ht-status-dot-active" style="width:6px;height:6px;"></span>
                                            <span>Active (Identity)</span>
                                        </span>
                                        @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-danger text-white">Locked Out</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Access: Normal</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="ht-btn-action-sm ht-manage-role-btn"
                                            data-user-id="@user.Id"
                                            data-user-email="@user.Email"
                                            data-user-role="@normalizedRole"
                                            title="Manage role for @user.Email">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                        </svg>
                                        <span>Manage Role</span>
                                    </button>
                                </td>
                            </tr>
                        }

                        <!-- Filter No Results Empty State -->
                        <tr id="userEmptyState" style="display: none;">
                            <td colspan="5" class="text-center py-5 text-muted">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mb-2 text-secondary">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <div>No users match the search and filter criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Role Change Modal (Integration-Ready UI with Safe Handover Protection) -->
<div class="ht-modal-backdrop" id="htRoleModal" role="dialog" aria-modal="true" aria-labelledby="roleModalTitle">
    <div class="ht-modal-card">
        <div class="ht-modal-header">
            <h2 class="ht-modal-title" id="roleModalTitle">Manage Account Role</h2>
            <button type="button" class="btn-close" id="roleModalClose" aria-label="Close dialog"></button>
        </div>
        <div class="ht-modal-body">
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Account Email</label>
                <div class="fw-bold text-dark fs-6" id="modalUserEmail">user@example.com</div>
                <input type="hidden" id="modalUserId" />
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Current Assigned Role</label>
                <div>
                    <span class="ht-role-badge ht-role-admin" id="modalCurrentRole">Admin</span>
                </div>
            </div>

            <div class="mb-3">
                <label for="modalRoleSelect" class="form-label fw-bold text-dark">Assign New Role</label>
                <select class="form-select" id="modalRoleSelect">
                    <option value="Client">Client (Personal Health & Fitness)</option>
                    <option value="Trainer">Trainer (Coaching & Routines)</option>
                    <option value="Admin">Admin (System Management)</option>
                </select>
                <div class="form-text text-muted small">
                    Role changes must update ASP.NET Core Identity role claims and the custom <code>User.role</code> property.
                </div>
            </div>

            <!-- Self-Demotion / Lockout Notice -->
            <div class="alert alert-warning py-2 px-3 small mb-3" id="modalSelfDemoteNotice" style="display: none;">
                <strong>Warning:</strong> You are managing the default Administrator account. Changing this role can lock you out of the Admin Portal.
            </div>

            <!-- Integration Notice -->
            <div class="p-3 bg-light rounded-3 border small text-muted">
                <div class="fw-bold text-dark mb-1">Backend Integration Pending</div>
                <div>Action endpoint <code>POST /Admin/UpdateUserRole</code> is not yet implemented in <code>AdminController.cs</code>. The submission button below is safely disabled to prevent unhandled submissions.</div>
            </div>
        </div>
        <div class="ht-modal-footer">
            <button type="button" class="btn btn-outline-secondary" id="roleModalCancel">Cancel</button>
            <button type="button" class="btn btn-primary" id="modalSubmitRoleBtn" style="background-color: #095c4d; border-color: #095c4d;" title="Endpoint pending backend implementation">
                Requires Backend Endpoint
            </button>
        </div>
    </div>
</div>
