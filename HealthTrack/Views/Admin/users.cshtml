@model IEnumerable<HealthTrack.ViewModels.Admin.UserListViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<div class="ht-dashboard-container">
    <div class="ht-welcome-section mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="ht-welcome-title">User Management</h1>
            <p class="ht-welcome-subtitle">All registered users in the system</p>
        </div>
        <a asp-controller="Admin" asp-action="createTrainer" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Trainer
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ht-card">
        <div class="ht-card-header-flex mb-3">
            <h2 class="ht-card-title mb-0">All Users</h2>
            <span class="ht-badge-total">@Model.Count() Total</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table ht-trainer-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ht-th-col" style="width: 40%;">NAME</th>
                            <th class="ht-th-col" style="width: 40%;">EMAIL</th>
                            <th class="ht-th-col text-end" style="width: 20%;">ROLE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr class="ht-client-row">
                                <td><span class="fw-semibold">@u.displayName</span></td>
                                <td><span class="text-muted">@u.email</span></td>
                                <td class="text-end">
                                    <span class="badge @(u.role == "Admin" ? "bg-danger" : u.role == "Trainer" ? "bg-success" : "bg-primary")">
                                        @u.role
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <em>No users registered yet.</em>
            </div>
        }
    </div>
</div>