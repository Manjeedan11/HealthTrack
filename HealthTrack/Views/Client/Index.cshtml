@model HealthTrack.Models.ClientDashboardViewModel
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Client Dashboard";
    ViewData["ClientName"] = Model.ClientName;
    ViewData["ClientInitials"] = Model.Initials;
}

<div class="ht-dashboard-container">
    @if (Model.IsDemonstrationData)
    {
        <div class="ht-demo-notice alert alert-info d-flex align-items-center mb-4" role="alert">
            <svg class="me-2 flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <div class="small">
                <strong>Demonstration Preview:</strong> Displaying representative data matching the coursework specification. Live records will populate automatically upon configuring the database connection.
            </div>
        </div>
    }

    <!-- Welcome Section -->
    <div class="ht-welcome-section mb-4">
        <h1 class="ht-welcome-title">Welcome back, @Model.FirstName</h1>
        <p class="ht-welcome-subtitle">Here's your health and fitness overview.</p>
    </div>

    <!-- Quick Action Buttons Row -->
    <div class="ht-quick-actions mb-4" role="toolbar" aria-label="Quick Actions">
        <a asp-controller="Workout" asp-action="index" class="ht-action-btn">
            <span class="ht-action-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6"></path>
                    <path d="M9 21H3v-6"></path>
                    <path d="M21 3l-7 7"></path>
                    <path d="M3 21l7-7"></path>
                </svg>
            </span>
            <span>+ Log Workout</span>
        </a>

        <a asp-controller="Diet" asp-action="index" class="ht-action-btn">
            <span class="ht-action-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 2v20"></path>
                    <path d="M18 2a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4"></path>
                    <path d="M6 2v6a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2"></path>
                    <path d="M8 10v12"></path>
                </svg>
            </span>
            <span>+ Log Meal</span>
        </a>

        <a asp-controller="HealthMetric" asp-action="log" class="ht-action-btn">
            <span class="ht-action-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="12" x="2" y="6" rx="2"></rect>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M6 12h.01M18 12h.01"></path>
                </svg>
            </span>
            <span>+ Health Measurement</span>
        </a>

        <a asp-controller="Appointment" asp-action="book" class="ht-action-btn">
            <span class="ht-action-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" x2="16" y1="2" y2="6"></line>
                    <line x1="8" x2="8" y1="2" y2="6"></line>
                    <line x1="3" x2="21" y1="10" y2="10"></line>
                    <line x1="12" x2="12" y1="14"></line>
                    <line x1="10" x2="14" y1="14"></line>
                </svg>
            </span>
            <span>+ Book Appointment</span>
        </a>
    </div>

    <!-- Health Summary KPI Cards (3 in a row) -->
    <div class="ht-kpi-grid mb-4">
        <!-- Body Weight Card -->
        <div class="ht-card ht-kpi-card">
            <div class="ht-kpi-top">
                <span class="ht-kpi-label">BODY WEIGHT</span>
                <span class="ht-kpi-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 22h14"></path>
                        <path d="M5 2h14"></path>
                        <path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path>
                        <path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path>
                    </svg>
                </span>
            </div>
            <div class="ht-kpi-val-row">
                <span class="ht-kpi-val">@(Model.BodyWeight.HasValue ? Model.BodyWeight.Value.ToString("0.0") : "--")</span>
                <span class="ht-kpi-unit">@Model.WeightUnit</span>
            </div>
            <div class="ht-kpi-sub">
                @if (Model.WeightTrend.HasValue)
                {
                    <span class="ht-trend-text">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="7" y1="7" x2="17" y2="17"></line>
                            <polyline points="17 7 17 17 7 17"></polyline>
                        </svg>
                        @(Model.WeightTrend.Value > 0 ? "+" : "")@Model.WeightTrend.Value.ToString("0.0") kg
                    </span>
                }
                else
                {
                    <span class="text-muted small">No trend history</span>
                }
            </div>
        </div>

        <!-- BMI Card -->
        <div class="ht-card ht-kpi-card">
            <div class="ht-kpi-top">
                <span class="ht-kpi-label">BMI</span>
                <span class="ht-kpi-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="5" r="2"></circle>
                        <path d="m9 20 3-6 3 6"></path>
                        <path d="m6 8 6 2 6-2"></path>
                        <path d="M12 10v4"></path>
                    </svg>
                </span>
            </div>
            <div class="ht-kpi-val-row">
                <span class="ht-kpi-val">@(Model.Bmi.HasValue ? Model.Bmi.Value.ToString("0.0") : "--")</span>
                <span class="ht-kpi-unit">@Model.BmiUnit</span>
            </div>
            <div class="ht-kpi-sub">
                @if (!string.IsNullOrEmpty(Model.BmiCategory))
                {
                    <span class="ht-pill-normal">@Model.BmiCategory</span>
                }
                else
                {
                    <span class="text-muted small">Requires height/weight</span>
                }
            </div>
        </div>

        <!-- Calories Burned Card -->
        <div class="ht-card ht-kpi-card">
            <div class="ht-kpi-top">
                <span class="ht-kpi-label">CALORIES BURNED</span>
                <span class="ht-kpi-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                    </svg>
                </span>
            </div>
            <div class="ht-kpi-val-row">
                <span class="ht-kpi-val">@(Model.CaloriesBurned.HasValue ? Model.CaloriesBurned.Value.ToString("N0") : "--")</span>
                <span class="ht-kpi-unit">kcal</span>
            </div>
            <div class="ht-kpi-sub">
                <span class="ht-goal-text">Goal: @(Model.CaloriesGoal.HasValue ? Model.CaloriesGoal.Value.ToString("N0") : "2,200")</span>
            </div>
        </div>
    </div>

    <!-- Main 2-Column Dashboard Cards Grid -->
    <div class="ht-main-grid">
        <!-- Card 1: Today's Workout -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Today's Workout</h2>
                <a asp-controller="Workout" asp-action="index" class="ht-card-link">View Workout Plan &rarr;</a>
            </div>

            @if (Model.HasWorkout)
            {
                <h3 class="ht-card-feature-title">@Model.WorkoutTitle</h3>
                <div class="ht-card-info-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-muted">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>@Model.WorkoutSchedule</span>
                </div>
                <div class="ht-card-info-item text-muted">
                    <span>Assigned by: <strong>@Model.WorkoutTrainer</strong></span>
                </div>
            }
            else
            {
                <p class="ht-empty-state">No workout plan assigned yet.</p>
            }
        </div>

        <!-- Card 2: Upcoming Appointment -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Upcoming Appointment</h2>
                <a asp-controller="Appointment" asp-action="index" class="ht-card-link">View Appointment &rarr;</a>
            </div>

            @if (Model.HasAppointment)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="ht-card-feature-title mb-0">@Model.AppointmentTitle</h3>
                    <span class="ht-pill-confirmed">@Model.AppointmentStatus</span>
                </div>
                <div class="ht-card-info-item text-muted">
                    <span>Provider: <strong>@Model.AppointmentProvider</strong></span>
                </div>
                <div class="ht-card-info-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-muted">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                        <line x1="16" x2="16" y1="2" y2="6"></line>
                        <line x1="8" x2="8" y1="2" y2="6"></line>
                        <line x1="3" x2="21" y1="10" y2="10"></line>
                    </svg>
                    <span>@Model.AppointmentSchedule</span>
                </div>
            }
            else
            {
                <p class="ht-empty-state">No upcoming appointments scheduled.</p>
            }
        </div>

        <!-- Card 3: Today's Diet Plan -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Today's Diet Plan</h2>
                <a asp-controller="Diet" asp-action="index" class="ht-card-link">View Diet Plan &rarr;</a>
            </div>

            @if (Model.HasDietPlan)
            {
                <div class="ht-diet-plan-meta mb-3">
                    <span class="text-muted">Current Plan: <strong>@Model.DietPlanName</strong></span>
                </div>

                <div class="ht-meals-list">
                    @foreach (var meal in Model.Meals)
                    {
                        <div class="ht-meal-row">
                            <span class="ht-meal-text"><strong>@meal.MealType:</strong> @meal.MealName</span>
                            @if (meal.IsCompleted)
                            {
                                <span class="ht-pill-completed">@meal.TimeOrStatus</span>
                            }
                            else
                            {
                                <span class="ht-meal-time">@meal.TimeOrStatus</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="ht-empty-state">No diet plan assigned yet.</p>
            }
        </div>

        <!-- Card 4: Progress Tracking -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Progress Tracking</h2>
                <a asp-controller="HealthMetric" asp-action="index" class="ht-card-link">View Progress &rarr;</a>
            </div>

            @if (Model.HasProgress && Model.ProgressPoints.Any())
            {
                <div class="ht-progress-header mb-3">
                    <span class="ht-progress-diff">@Model.ProgressSummary</span>
                    <span class="ht-progress-range text-muted">@Model.ProgressRange</span>
                </div>

                <!-- Clean SVG Line Chart matching reference -->
                <div class="ht-chart-box">
                    <svg viewBox="0 0 400 120" class="ht-progress-chart" preserveAspectRatio="none" aria-label="Weight progress trend chart">
                        <!-- Horizontal reference guideline -->
                        <line x1="20" y1="65" x2="380" y2="65" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4 4" />

                        <!-- Trend Line -->
                        <polyline fill="none" stroke="#095c4d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                  points="40,40 140,55 240,75 360,95" />

                        <!-- Data Points -->
                        <circle cx="40" cy="40" r="4.5" fill="#ffffff" stroke="#095c4d" stroke-width="2.5" />
                        <circle cx="140" cy="55" r="4.5" fill="#ffffff" stroke="#095c4d" stroke-width="2.5" />
                        <circle cx="240" cy="75" r="4.5" fill="#ffffff" stroke="#095c4d" stroke-width="2.5" />
                        <circle cx="360" cy="95" r="4.5" fill="#095c4d" stroke="#095c4d" stroke-width="2.5" />
                    </svg>

                    <!-- Chart Bottom Labels -->
                    <div class="ht-chart-labels">
                        @foreach (var pt in Model.ProgressPoints)
                        {
                            <span class="ht-chart-label">@pt.Label (@pt.Weight.ToString("0.0")kg)</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="ht-empty-state">No historical measurement records yet.</p>
            }
        </div>

        <!-- Card 5: Reminders -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Reminders</h2>
                <a asp-controller="Notification" asp-action="index" class="ht-card-link">View All &rarr;</a>
            </div>

            <div class="ht-reminders-list">
                @if (Model.Reminders.Any())
                {
                    @foreach (var reminder in Model.Reminders)
                    {
                        <div class="ht-reminder-row">
                            <span class="ht-reminder-title">@reminder.Title</span>
                            <span class="ht-reminder-time text-muted">@reminder.Time</span>
                        </div>
                    }
                }
                else
                {
                    <p class="ht-empty-state">No reminders scheduled for today.</p>
                }
            </div>
        </div>

        <!-- Card 6: Latest Trainer Feedback -->
        <div class="ht-card">
            <div class="ht-card-header-row">
                <h2 class="ht-card-heading">Latest Trainer Feedback</h2>
                <a asp-controller="Feedback" asp-action="myFeedback" class="ht-card-link">View Feedback &rarr;</a>
            </div>

            @if (Model.HasFeedback)
            {
                <div class="ht-feedback-card">
                    <p class="ht-feedback-quote mb-2">@Model.FeedbackComment</p>
                    <span class="ht-feedback-author text-muted">@Model.FeedbackMeta</span>
                </div>
            }
            else
            {
                <p class="ht-empty-state">No trainer feedback received yet.</p>
            }
        </div>
    </div>
</div>
