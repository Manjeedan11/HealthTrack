@model HealthTrack.ViewModels.Shared.AppointmentIndexViewModel
@{
    bool isTrainer = Model.IsTrainer;
    Layout = isTrainer ? "_TrainerLayout" : "_ClientLayout";
    ViewData["Title"] = isTrainer ? "Trainer Appointments" : "Client Appointments";

    int totalCount = Model.TotalCount;
    int pendingCount = Model.PendingCount;
    int confirmedCount = Model.ConfirmedCount;
    int cancelledCount = Model.CancelledCount;
    int completedCount = Model.CompletedCount;
}

<div class="ht-dashboard-container">

    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Breadcrumb -->
    <div class="mb-3">
        <a asp-controller="@(isTrainer ? "Trainer" : "Client")" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Dashboard</span>
        </a>
    </div>

    @if (isTrainer)
    {
        <!-- ============================================================ -->
        <!-- TRAINER APPOINTMENTS VIEW                                    -->
        <!-- ============================================================ -->
        <div class="ht-trainer-header-row mb-4">
            <div>
                <h1 class="ht-welcome-title">Trainer Appointments</h1>
                <p class="ht-welcome-subtitle">Review consultation requests, confirm upcoming client appointments, and manage schedules.</p>
            </div>
            <div class="ht-trainer-actions-group">
                <span class="ht-status-badge ht-status-confirmed px-3 py-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>@confirmedCount Confirmed</span>
                </span>
            </div>
        </div>

        <!-- KPI Summary Row (5 Cards) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
            <!-- Total -->
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">TOTAL</span>
                        <span class="ht-kpi-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val">@totalCount</span>
                        <span class="ht-kpi-unit">sessions</span>
                    </div>
                    <div class="text-muted small mt-2">Overall assigned</div>
                </div>
            </div>

            <!-- Pending -->
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">PENDING</span>
                        <span class="ht-kpi-icon text-warning" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val text-warning">@pendingCount</span>
                        <span class="ht-kpi-unit">requests</span>
                    </div>
                    <div class="text-muted small mt-2">Awaiting confirmation</div>
                </div>
            </div>

            <!-- Confirmed -->
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">CONFIRMED</span>
                        <span class="ht-kpi-icon text-success" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val text-success">@confirmedCount</span>
                        <span class="ht-kpi-unit">booked</span>
                    </div>
                    <div class="text-muted small mt-2">Active scheduled</div>
                </div>
            </div>

            <!-- Completed -->
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">COMPLETED</span>
                        <span class="ht-kpi-icon" style="color: #1e40af;" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val" style="color: #1e40af;">@completedCount</span>
                        <span class="ht-kpi-unit">done</span>
                    </div>
                    <div class="text-muted small mt-2">Finished sessions</div>
                </div>
            </div>

            <!-- Cancelled -->
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">CANCELLED</span>
                        <span class="ht-kpi-icon text-danger" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val text-muted">@cancelledCount</span>
                        <span class="ht-kpi-unit">cancelled</span>
                    </div>
                    <div class="text-muted small mt-2">Closed or declined</div>
                </div>
            </div>
        </div>

        <!-- Appointments List Card -->
        <div class="ht-card">
            <div class="ht-card-header-flex mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="ht-card-title mb-0">Scheduled Consultations</h2>
                    <span class="ht-status-badge ht-status-confirmed">@totalCount Total</span>
                </div>
            </div>

            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table ht-trainer-table align-middle mb-0" aria-label="Trainer Scheduled Appointments">
                        <thead>
                            <tr>
                                <th scope="col" class="ht-th-col" style="width: 22%;">DATE &amp; TIME</th>
                                <th scope="col" class="ht-th-col" style="width: 20%;">CLIENT</th>
                                <th scope="col" class="ht-th-col" style="width: 28%;">NOTES</th>
                                <th scope="col" class="ht-th-col" style="width: 30%;">STATUS / ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Appointments.OrderBy(a => a.dateTime))
                            {
                                string clientDisplay = appt.client != null && !string.IsNullOrWhiteSpace(appt.client.name)
                                    ? appt.client.name
                                    : $"Client #{appt.clientId}";

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            <span class="fw-semibold">@appt.dateTime.ToString("MMM d, yyyy · h:mm tt")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold" style="color: #0f172a;">@clientDisplay</div>
                                        <span class="text-muted small">ID: #CL-@appt.clientId</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrWhiteSpace(appt.notes) ? "Routine Health & Fitness Consultation" : appt.notes)</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            @if (string.Equals(appt.status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="ht-status-badge ht-status-confirmed">Confirmed</span>
                                            }
                                            else if (string.Equals(appt.status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="ht-status-badge ht-status-cancelled">Cancelled</span>
                                            }
                                            else if (string.Equals(appt.status, "Completed", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="ht-status-badge" style="background-color: #dbeafe; color: #1e40af;">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="ht-status-badge ht-status-pending">Pending Approval</span>
                                            }

                                            @if (string.Equals(appt.status, "Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="d-flex gap-2 mt-1">
                                                    <form asp-controller="Appointment" asp-action="updateStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appt.appointmentId" />
                                                        <input type="hidden" name="status" value="Confirmed" />
                                                        <button type="submit" class="btn btn-sm btn-success py-1 px-2" style="font-size: 0.75rem;">
                                                            Approve
                                                        </button>
                                                    </form>
                                                    <form asp-controller="Appointment" asp-action="updateStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appt.appointmentId" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.75rem;">
                                                            Cancel
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else if (string.Equals(appt.status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="d-flex gap-2 mt-1">
                                                    @if (appt.dateTime <= DateTime.Now)
                                                    {
                                                        <form asp-controller="Appointment" asp-action="updateStatus" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@appt.appointmentId" />
                                                            <input type="hidden" name="status" value="Completed" />
                                                            <button type="submit" class="btn btn-sm btn-primary py-1 px-2" style="font-size: 0.75rem;">
                                                                Mark Complete
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-controller="Appointment" asp-action="updateStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appt.appointmentId" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.75rem;">
                                                            Cancel
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 ht-health-empty-card">
                    <div class="ht-health-empty-icon mb-3" aria-hidden="true">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <h2 class="ht-card-title mb-2">No Appointments Assigned</h2>
                    <p class="ht-card-subtitle mx-auto mb-0" style="max-width: 480px;">
                        There are currently no consultation requests or scheduled appointments associated with your trainer account.
                    </p>
                </div>
            }
        </div>
    }
    else
    {
        <!-- ============================================================ -->
        <!-- CLIENT APPOINTMENTS VIEW                                     -->
        <!-- ============================================================ -->
        <div class="ht-trainer-header-row mb-4">
            <div>
                <h1 class="ht-welcome-title">My Appointments</h1>
                <p class="ht-welcome-subtitle">Schedule consultations with certified health and fitness trainers and track your appointment statuses.</p>
            </div>
            <div class="ht-trainer-actions-group">
                <a asp-controller="Appointment" asp-action="book" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto align-items-center gap-2" id="btnBookAppointment">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Book Appointment</span>
                </a>
            </div>
        </div>

        <!-- KPI Summary Row (4 Cards) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">TOTAL BOOKINGS</span>
                        <span class="ht-kpi-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val">@totalCount</span>
                        <span class="ht-kpi-unit">consultations</span>
                    </div>
                    <div class="text-muted small mt-2">Recorded session history</div>
                </div>
            </div>

            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">CONFIRMED</span>
                        <span class="ht-kpi-icon text-success" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val text-success">@confirmedCount</span>
                        <span class="ht-kpi-unit">upcoming</span>
                    </div>
                    <div class="text-muted small mt-2">Ready for consultation</div>
                </div>
            </div>

            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">PENDING</span>
                        <span class="ht-kpi-icon text-warning" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val text-warning">@pendingCount</span>
                        <span class="ht-kpi-unit">pending</span>
                    </div>
                    <div class="text-muted small mt-2">Awaiting trainer confirmation</div>
                </div>
            </div>

            <div class="col">
                <div class="ht-card ht-kpi-card h-100">
                    <div class="ht-kpi-top">
                        <span class="ht-kpi-label">COMPLETED</span>
                        <span class="ht-kpi-icon" style="color: #1e40af;" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                    </div>
                    <div class="ht-kpi-val-row">
                        <span class="ht-kpi-val" style="color: #1e40af;">@completedCount</span>
                        <span class="ht-kpi-unit">done</span>
                    </div>
                    <div class="text-muted small mt-2">Sessions completed</div>
                </div>
            </div>
        </div>

        <!-- Consultation History Card -->
        <div class="ht-card">
            <div class="ht-card-header-flex mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="ht-card-title mb-0">Consultation History</h2>
                    <span class="ht-status-badge ht-status-confirmed">@totalCount Records</span>
                </div>
            </div>

            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table ht-trainer-table align-middle mb-0" aria-label="Client Consultation Appointments">
                        <thead>
                            <tr>
                                <th scope="col" class="ht-th-col" style="width: 25%;">DATE &amp; TIME</th>
                                <th scope="col" class="ht-th-col" style="width: 25%;">TRAINER</th>
                                <th scope="col" class="ht-th-col" style="width: 30%;">CONSULTATION TOPIC</th>
                                <th scope="col" class="ht-th-col text-end" style="width: 20%;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Appointments.OrderByDescending(a => a.dateTime))
                            {
                                string trainerDisplay = appt.trainer != null && !string.IsNullOrWhiteSpace(appt.trainer.name)
                                    ? appt.trainer.name
                                    : $"Trainer #{appt.trainerId}";

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            <span class="fw-semibold">@appt.dateTime.ToString("MMM d, yyyy · h:mm tt")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold" style="color: #0f172a;">@trainerDisplay</div>
                                        <span class="text-muted small">Specialist</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrWhiteSpace(appt.notes) ? "Health & Fitness Consultation" : appt.notes)</span>
                                    </td>
                                    <td class="text-end">
                                        @if (string.Equals(appt.status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="ht-status-badge ht-status-confirmed">Confirmed</span>
                                        }
                                        else if (string.Equals(appt.status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="ht-status-badge ht-status-cancelled">Cancelled</span>
                                        }
                                        else if (string.Equals(appt.status, "Completed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="ht-status-badge" style="background-color: #dbeafe; color: #1e40af;">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="ht-status-badge ht-status-pending">Pending Approval</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 ht-health-empty-card" aria-label="No appointments">
                    <div class="ht-health-empty-icon mb-3" aria-hidden="true">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <h2 class="ht-card-title mb-2">No Appointments Scheduled</h2>
                    <p class="ht-card-subtitle mx-auto mb-4" style="max-width: 480px;">
                        You have not booked any appointments with a fitness trainer yet. Schedule a consultation to review workouts, nutrition, or overall health goals.
                    </p>
                    <a asp-controller="Appointment" asp-action="book" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto mx-auto" id="btnBookFirstAppointment">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Book First Consultation
                    </a>
                </div>
            }
        </div>
    }
</div>