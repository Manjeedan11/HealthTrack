@model IEnumerable<DietPlan>
@{
    bool isTrainer = User.IsInRole("Trainer");
    Layout = isTrainer ? "_TrainerLayout" : "_ClientLayout";
    ViewData["Title"] = "Diet Plans";
}

<div class="ht-dashboard-container">
    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Breadcrumb & Back Link -->
    <div class="mb-3">
        <a asp-controller="@(isTrainer ? "Trainer" : "Client")" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to @(isTrainer ? "Trainer Dashboard" : "Dashboard")</span>
        </a>
    </div>

    <!-- Page Header & Action Row -->
    <div class="ht-trainer-header-row mb-4">
        <div>
            <h1 class="ht-welcome-title">Diet Plans</h1>
            <p class="ht-welcome-subtitle">
                @(isTrainer 
                    ? "Manage, review and assign personalised nutrition plans for your clients." 
                    : "View your personalised nutrition plans and scheduled daily meals.")
            </p>
        </div>

        @if (isTrainer)
        {
            <div class="ht-trainer-actions-group">
                <a asp-controller="Diet" asp-action="create" class="ht-action-card-btn" id="btn-create-diet-plan">
                    <span class="ht-action-card-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="ht-action-card-text">Create / Assign<br />Diet Plan</span>
                </a>
            </div>
        }
    </div>

    <!-- Diet Plans Listing -->
    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var plan in Model)
            {
                <article class="ht-card ht-diet-card" aria-labelledby="plan-heading-@plan.dietId">
                    <!-- Plan Card Header -->
                    <div class="ht-card-header-flex mb-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="ht-header-icon-badge ht-diet-icon-badge" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 2v20"></path>
                                    <path d="M18 2a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4"></path>
                                    <path d="M6 2v6a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2"></path>
                                    <path d="M8 10v12"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="ht-card-title mb-1" id="plan-heading-@plan.dietId">@plan.name</h2>
                                <p class="ht-card-subtitle mb-0">
                                    @(string.IsNullOrWhiteSpace(plan.description) ? "No detailed dietary instructions provided." : plan.description)
                                </p>
                            </div>
                        </div>

                        <!-- Metadata Badges -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="ht-badge-total ht-diet-badge-date">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                    <line x1="16" x2="16" y1="2" y2="6"></line>
                                    <line x1="8" x2="8" y1="2" y2="6"></line>
                                    <line x1="3" x2="21" y1="10" y2="10"></line>
                                </svg>
                                @plan.dateCreated.ToString("MMM d, yyyy")
                            </span>
                            <span class="ht-status-badge ht-status-confirmed">
                                @(plan.meals?.Count ?? 0) @(plan.meals?.Count == 1 ? "Meal" : "Meals")
                            </span>
                            <span class="ht-diet-calorie-badge">
                                @(plan.meals != null && plan.meals.Any() ? plan.meals.Sum(m => m.calories) : 0) kcal
                            </span>
                        </div>
                    </div>

                    <!-- Meals Detail Table -->
                    @if (plan.meals != null && plan.meals.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table ht-trainer-table align-middle mb-0" aria-label="Meals for @plan.name">
                                <thead>
                                    <tr>
                                        <th scope="col" class="ht-th-col" style="width: 42%;">MEAL</th>
                                        <th scope="col" class="ht-th-col" style="width: 25%;">TIMING / MEAL TIME</th>
                                        <th scope="col" class="ht-th-col text-end" style="width: 33%;">CALORIES / ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var meal in plan.meals)
                                    {
                                        <tr class="ht-client-row">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="ht-diet-meal-bullet" aria-hidden="true"></span>
                                                    <span class="ht-client-name">@meal.name</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="ht-diet-time-badge">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1 text-muted">
                                                        <circle cx="12" cy="12" r="10"></circle>
                                                        <polyline points="12 6 12 12 16 14"></polyline>
                                                    </svg>
                                                    @meal.mealTime
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex flex-column align-items-end gap-1">
                                                    <span class="ht-workout-duration-text">
                                                        @meal.calories kcal
                                                    </span>
                                                    @if (!isTrainer)
                                                    {
                                                        <a asp-controller="Diet" asp-action="log"
                                                           asp-route-mealId="@meal.mealId"
                                                           asp-route-planId="@plan.dietId"
                                                           class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.7rem;">
                                                            Log Consumed
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="ht-diet-empty-meals p-3 text-muted text-center">
                            No meals have been scheduled for this diet plan yet.
                        </div>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <section class="ht-card text-center py-5 ht-diet-empty-card" aria-label="No diet plans available">
            <div class="ht-diet-empty-icon mb-3" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 2v20"></path>
                    <path d="M18 2a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4"></path>
                    <path d="M6 2v6a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2"></path>
                    <path d="M8 10v12"></path>
                </svg>
            </div>
            <h2 class="ht-card-title mb-2">No Diet Plans Found</h2>
            <p class="ht-card-subtitle mx-auto mb-4" style="max-width: 480px;">
                @(isTrainer 
                    ? "You haven't assigned any diet plans to this client yet. Create and configure a personalised nutrition plan with targeted daily meals, calories and timings." 
                    : "No diet plans have been assigned to your account yet. Your trainer will provide your personalised nutrition plan once your dietary consultation is complete.")
            </p>
            @if (isTrainer)
            {
                <a asp-controller="Diet" asp-action="create" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto mx-auto">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create First Diet Plan
                </a>
            }
        </section>
    }

    <!-- Recent Meal Logs (Client only) -->
    @if (!isTrainer && ViewBag.RecentLogs != null)
    {
        var logs = ViewBag.RecentLogs as List<MealLog>;
        if (logs != null && logs.Any())
        {
            <div class="ht-card mt-4">
                <div class="ht-card-header-flex mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="ht-card-title mb-0">Recent Meal Logs</h2>
                        <span class="ht-status-badge ht-status-confirmed">@logs.Count entries</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table ht-trainer-table align-middle mb-0" aria-label="Recent meal logs">
                        <thead>
                            <tr>
                                <th class="ht-th-col" style="width: 25%;">DATE</th>
                                <th class="ht-th-col" style="width: 35%;">MEAL</th>
                                <th class="ht-th-col" style="width: 20%;">CALORIES</th>
                                <th class="ht-th-col text-end" style="width: 20%;">NOTES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lg in logs)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@lg.date.ToString("MMM d, yyyy · h:mm tt")</span></td>
                                    <td>@(lg.meal?.name ?? "Free-form meal")</td>
                                    <td><span class="fw-semibold">@lg.caloriesConsumed kcal</span></td>
                                    <td class="text-end text-muted small">@(string.IsNullOrWhiteSpace(lg.notes) ? "—" : lg.notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>