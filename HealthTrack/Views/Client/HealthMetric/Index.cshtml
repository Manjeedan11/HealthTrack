@model IEnumerable<HealthMetric>
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Health Measurements";
    var list = Model?.OrderByDescending(m => m.date).ToList() ?? new List<HealthMetric>();
    var latest = list.FirstOrDefault();
}

<div class="ht-dashboard-container">
    <div class="mb-3">
        <a asp-controller="Client" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Dashboard</span>
        </a>
    </div>

    <div class="ht-trainer-header-row mb-4">
        <div>
            <h1 class="ht-welcome-title">Health Measurements</h1>
            <p class="ht-welcome-subtitle">Track your weight, BMI and daily calorie balance.</p>
        </div>
        <a asp-controller="HealthMetric" asp-action="log" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Log Measurement
        </a>
    </div>

    <!-- KPI Row -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        <div class="col">
            <div class="ht-card ht-kpi-card h-100">
                <div class="ht-kpi-top"><span class="ht-kpi-label">BODY WEIGHT</span></div>
                <div class="ht-kpi-val-row">
                    <span class="ht-kpi-val">@(latest?.weight.ToString("0.0") ?? "—")</span>
                    <span class="ht-kpi-unit">kg</span>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="ht-card ht-kpi-card h-100">
                <div class="ht-kpi-top"><span class="ht-kpi-label">BMI</span></div>
                <div class="ht-kpi-val-row">
                    <span class="ht-kpi-val">@(latest?.bmi.ToString("0.0") ?? "—")</span>
                    <span class="ht-kpi-unit">kg/m²</span>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="ht-card ht-kpi-card h-100">
                <div class="ht-kpi-top"><span class="ht-kpi-label">CALORIES BURNED</span></div>
                <div class="ht-kpi-val-row">
                    <span class="ht-kpi-val text-success">@(latest?.caloriesBurned.ToString("N0") ?? "0")</span>
                    <span class="ht-kpi-unit">kcal</span>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="ht-card ht-kpi-card h-100">
                <div class="ht-kpi-top"><span class="ht-kpi-label">NET INTAKE</span></div>
                <div class="ht-kpi-val-row">
                    <span class="ht-kpi-val @((latest?.caloriesConsumed ?? 0) < 0 ? "text-success" : "text-warning")">
                        @(latest?.caloriesConsumed.ToString("N0") ?? "0")
                    </span>
                    <span class="ht-kpi-unit">kcal</span>
                </div>
            </div>
        </div>
    </div>

    <!-- History Table -->
    @if (list.Any())
    {
        <div class="ht-card">
            <div class="ht-card-header-flex mb-3">
                <h2 class="ht-card-title mb-0">Measurement History</h2>
                <span class="ht-badge-total">@list.Count Records</span>
            </div>
            <div class="table-responsive">
                <table class="table ht-trainer-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ht-th-col" style="width: 20%;">DATE</th>
                            <th class="ht-th-col" style="width: 15%;">HEIGHT</th>
                            <th class="ht-th-col" style="width: 15%;">WEIGHT</th>
                            <th class="ht-th-col" style="width: 15%;">BMI</th>
                            <th class="ht-th-col" style="width: 17%;">BURNED</th>
                            <th class="ht-th-col text-end" style="width: 18%;">NET INTAKE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in list)
                        {
                            <tr class="ht-client-row">
                                <td><span class="fw-semibold">@m.date.ToString("MMM d, yyyy")</span></td>
                                <td>@(m.height?.ToString("0") ?? "—") cm</td>
                                <td><span class="fw-bold">@m.weight.ToString("0.0") kg</span></td>
                                <td><span class="fw-semibold">@m.bmi.ToString("0.0")</span></td>
                                <td><span class="ht-workout-duration-text">@m.caloriesBurned.ToString("N0") kcal</span></td>
                                <td class="text-end">
                                    <span class="fw-semibold @(m.caloriesConsumed < 0 ? "text-success" : "text-muted")">
                                        @m.caloriesConsumed.ToString("N0") kcal
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="ht-card text-center py-5">
            <p class="text-muted mb-3">No measurements recorded yet.</p>
            <a asp-controller="HealthMetric" asp-action="log" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto">Log First Measurement</a>
        </div>
    }
</div>