@model HealthMetric
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Log Health Measurement";
    int burn = ViewBag.CurrentCaloriesBurned ?? 0;
    int net = ViewBag.CurrentNetConsumed ?? 0;
}

<div class="ht-dashboard-container">
    <div class="mb-3">
        <a asp-controller="Client" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Dashboard</span>
        </a>
    </div>

    <div class="ht-welcome-section mb-4">
        <h1 class="ht-welcome-title">Log Health Measurement</h1>
        <p class="ht-welcome-subtitle">Enter your height and weight. BMI is calculated automatically. Calories come from your daily logs.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            <div class="ht-card">
                <div class="ht-card-header-flex mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="12" x="2" y="6" rx="2"></rect>
                                <circle cx="12" cy="12" r="2"></circle>
                                <path d="M6 12h.01M18 12h.01"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0">Measurement Entry</h2>
                            <p class="ht-card-subtitle mb-0">Today · @DateTime.Now.ToString("MMMM d, yyyy")</p>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>

                <form asp-controller="HealthMetric" asp-action="log" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <!-- Height -->
                        <div class="col-12 col-sm-6">
                            <div class="ht-form-group mb-0">
                                <label asp-for="height" class="ht-label">Height (cm) <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="3" x2="12" y2="21"></line>
                                            <polyline points="8 7 12 3 16 7"></polyline>
                                            <polyline points="8 17 12 21 16 17"></polyline>
                                        </svg>
                                    </span>
                                    <input asp-for="height"
                                           type="number"
                                           step="0.1"
                                           min="100"
                                           max="250"
                                           class="ht-input"
                                           placeholder="e.g., 175"
                                           required />
                                </div>
                                <span asp-validation-for="height" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Weight -->
                        <div class="col-12 col-sm-6">
                            <div class="ht-form-group mb-0">
                                <label asp-for="weight" class="ht-label">Body Weight (kg) <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 22h14"></path>
                                            <path d="M5 2h14"></path>
                                            <path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path>
                                        </svg>
                                    </span>
                                    <input asp-for="weight"
                                           type="number"
                                           step="0.1"
                                           min="20"
                                           max="350"
                                           class="ht-input"
                                           placeholder="e.g., 72.4"
                                           required />
                                </div>
                                <span asp-validation-for="weight" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Auto-calculated calories -->
                        <div class="col-12">
                            <div class="ht-card p-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d6e5a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                    <strong class="small" style="color: #0d6e5a;">Auto-Calculated Today</strong>
                                </div>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="small text-muted mb-1">Calories Burned</div>
                                        <div class="fw-bold" style="font-size: 1.15rem;">@burn.ToString("N0") <span class="text-muted small">kcal</span></div>
                                        <div class="small text-muted">From workout logs</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="small text-muted mb-1">Net Intake</div>
                                        <div class="fw-bold @(net < 0 ? "text-success" : "")" style="font-size: 1.15rem;">@net.ToString("N0") <span class="text-muted small">kcal</span></div>
                                        <div class="small text-muted">Eaten minus burned</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-3 border-top">
                        <a asp-controller="HealthMetric" asp-action="index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        <button type="submit" class="ht-btn-submit px-4">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Save Measurement</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}