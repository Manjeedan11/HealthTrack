@model IEnumerable<WorkoutPlan>
@{
    bool isTrainer = User.IsInRole("Trainer");
    Layout = isTrainer ? "_TrainerLayout" : "_ClientLayout";
    ViewData["Title"] = "Workout Plans";
}

<div class="ht-dashboard-container">
    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Breadcrumb & Back Link -->
    <div class="mb-3">
        <a asp-controller="@(isTrainer ? "Trainer" : "Client")" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to @(isTrainer ? "Trainer Dashboard" : "Dashboard")</span>
        </a>
    </div>

    <!-- Page Header & Action Row -->
    <div class="ht-trainer-header-row mb-4">
        <div>
            <h1 class="ht-welcome-title">Workout Plans</h1>
            <p class="ht-welcome-subtitle">
                @(isTrainer 
                    ? "Manage, review and assign customized workout routines for your clients." 
                    : "View your personalized workout routines and daily exercise targets.")
            </p>
        </div>

        @if (isTrainer)
        {
            <div class="ht-trainer-actions-group">
                <a asp-controller="Workout" asp-action="create" class="ht-action-card-btn" id="btn-create-workout-plan">
                    <span class="ht-action-card-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="ht-action-card-text">Create / Assign<br />Workout</span>
                </a>
            </div>
        }
    </div>

    <!-- Workout Plans Listing -->
    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var plan in Model)
            {
                <article class="ht-card ht-workout-card" aria-labelledby="plan-heading-@plan.planId">
                    <!-- Plan Card Header -->
                    <div class="ht-card-header-flex mb-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="ht-header-icon-badge ht-workout-icon-badge" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6.5 6.5 11 11"></path>
                                    <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-.88.88a2 2 0 0 1-2.83 0l-1.58-1.58a2 2 0 0 1 0-2.83l.88-.88a2 2 0 0 0 0-2.83L11.5 10.5"></path>
                                    <path d="m3 3 1 1a2 2 0 0 0 2.83 0l.88-.88a2 2 0 0 1 2.83 0l1.58 1.58a2 2 0 0 1 0 2.83l-.88.88a2 2 0 0 0 0 2.83l2.25 2.25"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="ht-card-title mb-1" id="plan-heading-@plan.planId">@plan.name</h2>
                                <p class="ht-card-subtitle mb-0">
                                    @(string.IsNullOrWhiteSpace(plan.description) ? "No detailed instructions provided." : plan.description)
                                </p>
                            </div>
                        </div>

                        <!-- Metadata Badges -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="ht-badge-total ht-workout-badge-date">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                    <line x1="16" x2="16" y1="2" y2="6"></line>
                                    <line x1="8" x2="8" y1="2" y2="6"></line>
                                    <line x1="3" x2="21" y1="10" y2="10"></line>
                                </svg>
                                @plan.dateCreated.ToString("MMM d, yyyy")
                            </span>
                            <span class="ht-status-badge ht-status-confirmed">
                                @(plan.exercises?.Count ?? 0) @(plan.exercises?.Count == 1 ? "Exercise" : "Exercises")
                            </span>
                        </div>
                    </div>

                    <!-- Exercises Detail Table -->
                    @if (plan.exercises != null && plan.exercises.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table ht-trainer-table align-middle mb-0" aria-label="Exercises for @plan.name">
                                <thead>
                                    <tr>
                                        <th scope="col" class="ht-th-col" style="width: 40%;">EXERCISE</th>
                                        <th scope="col" class="ht-th-col" style="width: 15%;">SETS</th>
                                        <th scope="col" class="ht-th-col" style="width: 15%;">REPS</th>
                                        <th scope="col" class="ht-th-col text-end" style="width: 30%;">DURATION / ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ex in plan.exercises)
                                    {
                                        <tr class="ht-client-row">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="ht-workout-exercise-bullet" aria-hidden="true"></span>
                                                    <span class="ht-client-name">@ex.name</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="ht-workout-stat-badge">@ex.sets sets</span>
                                            </td>
                                            <td>
                                                <span class="ht-workout-stat-badge">@ex.reps reps</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex flex-column align-items-end gap-1">
                                                    <span class="ht-workout-duration-text">
                                                        @(ex.duration > 0 ? $"{ex.duration} min" : "—")
                                                    </span>
                                                    @if (!isTrainer)
                                                    {
                                                        <a asp-controller="Workout" asp-action="log"
                                                           asp-route-exerciseId="@ex.exerciseId"
                                                           asp-route-planId="@plan.planId"
                                                           class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.7rem;">
                                                            Log Completed
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="ht-workout-empty-exercises p-3 text-muted text-center">
                            No exercises have been scheduled for this plan yet.
                        </div>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <section class="ht-card text-center py-5 ht-workout-empty-card" aria-label="No workout plans available">
            <div class="ht-workout-empty-icon mb-3" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6.5 6.5 11 11"></path>
                    <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-.88.88a2 2 0 0 1-2.83 0l-1.58-1.58a2 2 0 0 1 0-2.83l.88-.88a2 2 0 0 0 0-2.83L11.5 10.5"></path>
                    <path d="m3 3 1 1a2 2 0 0 0 2.83 0l.88-.88a2 2 0 0 1 2.83 0l1.58 1.58a2 2 0 0 1 0 2.83l-.88.88a2 2 0 0 0 0 2.83l2.25 2.25"></path>
                </svg>
            </div>
            <h2 class="ht-card-title mb-2">No Workout Plans Found</h2>
            <p class="ht-card-subtitle mx-auto mb-4" style="max-width: 480px;">
                @(isTrainer 
                    ? "You haven't assigned any workout plans to this client yet. Create and configure a routine with targeted exercises, sets, reps and durations." 
                    : "No workout plans have been assigned to your account yet. Your trainer will provide your routine once your fitness consultation is complete.")
            </p>
            @if (isTrainer)
            {
                <a asp-controller="Workout" asp-action="create" class="ht-btn-submit d-inline-flex px-4 py-2 w-auto mx-auto">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create First Workout Plan
                </a>
            }
        </section>
    }

    <!-- Recent Workout Logs (Client only) -->
    @if (!isTrainer && ViewBag.RecentLogs != null)
    {
        var logs = ViewBag.RecentLogs as List<WorkoutLog>;
        if (logs != null && logs.Any())
        {
            <div class="ht-card mt-4">
                <div class="ht-card-header-flex mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="ht-card-title mb-0">Recent Workout Logs</h2>
                        <span class="ht-status-badge ht-status-confirmed">@logs.Count entries</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table ht-trainer-table align-middle mb-0" aria-label="Recent workout logs">
                        <thead>
                            <tr>
                                <th class="ht-th-col" style="width: 25%;">DATE</th>
                                <th class="ht-th-col" style="width: 30%;">EXERCISE</th>
                                <th class="ht-th-col" style="width: 15%;">DURATION</th>
                                <th class="ht-th-col" style="width: 15%;">CALORIES</th>
                                <th class="ht-th-col text-end" style="width: 15%;">NOTES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lg in logs)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@lg.date.ToString("MMM d, yyyy · h:mm tt")</span></td>
                                    <td>@(lg.exercise?.name ?? "Free-form workout")</td>
                                    <td><span class="ht-workout-duration-text">@lg.durationMinutes min</span></td>
                                    <td><span class="fw-semibold">@lg.caloriesBurned cal</span></td>
                                    <td class="text-end text-muted small">@(string.IsNullOrWhiteSpace(lg.notes) ? "—" : lg.notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>