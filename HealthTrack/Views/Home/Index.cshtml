@{
    ViewData["Title"] = "HealthTrack — Where Athletes Check In";
}

<div class="ht-hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- LEFT: Text + CTA -->
            <div class="col-lg-6">
                <span class="ht-hero-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    Trusted by Athletes
                </span>

                <h1 class="ht-hero-title">
                    Every rep.<br />
                    Every meal.<br />
                    <span class="ht-hero-highlight">Every milestone.</span>
                </h1>

                <p class="ht-hero-subtitle">
                    HealthTrack is where serious athletes check in — track workouts, log nutrition, monitor health
                    metrics, and stay connected with your certified trainer. Your entire fitness journey, in one place.
                </p>

                <div class="ht-hero-cta">
                    <a asp-controller="Account" asp-action="login" class="ht-hero-btn-primary">
                        <span>Sign In to Check In</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a asp-controller="Account" asp-action="register" class="ht-hero-btn-secondary">
                        Create Account
                    </a>
                </div>

                <div class="ht-hero-trust">
                    <div class="ht-hero-trust-item">
                        <strong>500+</strong>
                        <span>Athletes</span>
                    </div>
                    <div class="ht-hero-trust-item">
                        <strong>50+</strong>
                        <span>Trainers</span>
                    </div>
                    <div class="ht-hero-trust-item">
                        <strong>10k+</strong>
                        <span>Workouts Logged</span>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-6">
                <div class="ht-hero-image-stack">

                   
                    <div class="ht-hero-image-card ht-hero-image-card-tall">
                        <img src="~/Images/max.jpg"
                             alt="Athlete training with HealthTrack"
                             onerror="this.style.display='none'; this.nextElementSibling.classList.add('is-visible');" />
                        <div class="ht-hero-image-placeholder">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                <circle cx="9" cy="9" r="2"></circle>
                                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                            </svg>
                            <span>max.jpg</span>
                        </div>
                    </div>

                    
                    <div class="ht-hero-bottom-row">

                     
                        <div class="ht-hero-image-card ht-hero-image-card-portrait">
                            <img src="~/Images/mbappe.jpg"
                                 alt="Athlete training session"
                                 onerror="this.style.display='none'; this.nextElementSibling.classList.add('is-visible');" />
                            <div class="ht-hero-image-placeholder">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                    <circle cx="9" cy="9" r="2"></circle>
                                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                                </svg>
                                <span>mbappe.jpg</span>
                            </div>
                        </div>

                       
                        <div class="ht-hero-image-card ht-hero-image-card-landscape">
                            <img src="~/Images/ronaldo.jpg"
                                 alt="Athlete tracking progress"
                                 onerror="this.style.display='none'; this.nextElementSibling.classList.add('is-visible');" />
                            <div class="ht-hero-image-placeholder">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                    <circle cx="9" cy="9" r="2"></circle>
                                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                                </svg>
                                <span>ronaldo.png</span>
                            </div>
                        </div>
                    </div>

                    <!-- Floating stat card -->
                    <div class="ht-hero-float-card">
                        <div class="ht-hero-float-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <div>
                            <strong>Today's Workout</strong>
                            <span>Completed · 45 min</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Feature Strip below hero -->
<div class="ht-home-features">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="ht-home-feature-card">
                    <div class="ht-home-feature-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h6v6"></path>
                            <path d="M9 21H3v-6"></path>
                            <path d="M21 3l-7 7"></path>
                            <path d="M3 21l7-7"></path>
                        </svg>
                    </div>
                    <h3>Train Harder</h3>
                    <p>Personalized workout plans from certified trainers, tailored to your goals.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ht-home-feature-card">
                    <div class="ht-home-feature-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 2v20"></path>
                            <path d="M6 2v6a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2"></path>
                            <path d="M8 10v12"></path>
                        </svg>
                    </div>
                    <h3>Eat Smarter</h3>
                    <p>Daily meal plans with calorie targets and macro tracking built in.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ht-home-feature-card">
                    <div class="ht-home-feature-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3v18h18"></path>
                            <path d="m19 9-5 5-4-4-3 3"></path>
                        </svg>
                    </div>
                    <h3>Track Progress</h3>
                    <p>Weight, BMI, and health metrics visualized over time — no guesswork.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ---------- Hero Section ---------- */
    .ht-hero-section {
        position: relative;
        padding: 80px 0 100px;
        background:
            radial-gradient(circle at 15% 20%, rgba(13, 110, 90, 0.06) 0%, transparent 45%),
            radial-gradient(circle at 85% 80%, rgba(2, 132, 199, 0.05) 0%, transparent 45%),
            linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        overflow: hidden;
    }

    .ht-hero-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        background: #ecfdf5;
        color: #0d6e5a;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-radius: 100px;
        border: 1px solid #a7f3d0;
        margin-bottom: 24px;
    }

    .ht-hero-title {
        font-size: 3.2rem;
        font-weight: 800;
        line-height: 1.1;
        color: #0f172a;
        letter-spacing: -1.5px;
        margin-bottom: 24px;
    }

    .ht-hero-highlight {
        color: #0d6e5a;
        background: linear-gradient(90deg, #0d6e5a 0%, #10b981 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .ht-hero-subtitle {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #64748b;
        margin-bottom: 36px;
        max-width: 540px;
    }

    .ht-hero-cta {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 48px;
    }

    .ht-hero-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        background: #0d6e5a;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(13, 110, 90, 0.25);
    }

    .ht-hero-btn-primary:hover {
        background: #095c4d;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(13, 110, 90, 0.35);
        color: #ffffff;
    }

    .ht-hero-btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 14px 28px;
        background: transparent;
        color: #0f172a;
        font-weight: 600;
        font-size: 0.95rem;
        border-radius: 10px;
        text-decoration: none;
        border: 1.5px solid #cbd5e1;
        transition: all 0.2s ease;
    }

    .ht-hero-btn-secondary:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }

    .ht-hero-trust {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
        padding-top: 32px;
        border-top: 1px solid #e2e8f0;
    }

    .ht-hero-trust-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .ht-hero-trust-item strong {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    .ht-hero-trust-item span {
        font-size: 0.75rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    /* ---------- Image Stack ---------- */
    .ht-hero-image-stack {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 20px;
    }

    .ht-hero-image-card {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        transition: transform 0.3s ease;
    }

    .ht-hero-image-card:hover {
        transform: translateY(-4px);
    }

    /* Slot 1: Tall primary — max.jpg (16:10 landscape) */
    .ht-hero-image-card-tall {
        aspect-ratio: 16 / 10;
        width: 85%;
        align-self: flex-start;
    }

    /* Row that holds portrait 3rd image + landscape ronaldo */
    .ht-hero-bottom-row {
        display: flex;
        gap: 16px;
        margin-top: -20px;   /* overlap upward onto max card */
        align-items: flex-start;
    }

    /* Slot 2: Portrait 3rd image — 1379×1691 = 4:5 */
    .ht-hero-image-card-portrait {
        aspect-ratio: 4 / 5;
        width: 38%;
    }

    /* Slot 3: Landscape ronaldo — 1531×1203 = 5:4 */
    .ht-hero-image-card-landscape {
        aspect-ratio: 5 / 4;
        width: 58%;
    }

    .ht-hero-image-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    /* Placeholder — hidden by default, shown when image fails */
    .ht-hero-image-placeholder {
        position: absolute;
        inset: 0;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        background:
            repeating-linear-gradient(45deg, rgba(148, 163, 184, 0.05) 0, rgba(148, 163, 184, 0.05) 10px, transparent 10px, transparent 20px),
            linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    }

    .ht-hero-image-placeholder.is-visible {
        display: flex;
    }

    /* ---------- Floating Stat Card ---------- */
    .ht-hero-float-card {
        position: absolute;
        bottom: 28px;
        left: 8px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
        z-index: 3;
        animation: htHeroFloat 4s ease-in-out infinite;
    }

    .ht-hero-float-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #ecfdf5;
        color: #0d6e5a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ht-hero-float-card strong {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        color: #0f172a;
    }

    .ht-hero-float-card span {
        display: block;
        font-size: 0.72rem;
        color: #64748b;
        margin-top: 1px;
    }

    @@keyframes htHeroFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    /* ---------- Feature Strip ---------- */
    .ht-home-features {
        padding: 60px 0 80px;
        background: #ffffff;
    }

    .ht-home-feature-card {
        padding: 28px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        height: 100%;
        transition: all 0.2s ease;
    }

    .ht-home-feature-card:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        transform: translateY(-2px);
    }

    .ht-home-feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #ecfdf5;
        color: #0d6e5a;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .ht-home-feature-card h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .ht-home-feature-card p {
        font-size: 0.9rem;
        line-height: 1.6;
        color: #64748b;
        margin: 0;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 991px) {
        .ht-hero-title {
            font-size: 2.4rem;
        }
        .ht-hero-section {
            padding: 60px 0 70px;
        }
        .ht-hero-image-card-tall {
            width: 100%;
        }
        .ht-hero-image-card-portrait {
            width: 42%;
        }
        .ht-hero-image-card-landscape {
            width: 54%;
        }
    }

    @@media (max-width: 576px) {
        .ht-hero-title {
            font-size: 1.9rem;
        }
        .ht-hero-cta {
            flex-direction: column;
        }
        .ht-hero-btn-primary,
        .ht-hero-btn-secondary {
            width: 100%;
            justify-content: center;
        }
        .ht-hero-trust {
            gap: 24px;
        }
        .ht-hero-bottom-row {
            flex-direction: column;
            gap: 12px;
        }
        .ht-hero-image-card-portrait,
        .ht-hero-image-card-landscape {
            width: 100%;
        }
    }
</style>