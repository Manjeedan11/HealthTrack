@model IEnumerable<Feedback>
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Trainer Feedback";

    var feedbackList = Model?.OrderByDescending(f => f.date).ToList() ?? new List<Feedback>();
    int totalCount = feedbackList.Count;
}

<div class="ht-dashboard-container">
    <!-- Breadcrumb & Back to Dashboard Link -->
    <div class="mb-3">
        <a asp-controller="Client" asp-action="index" class="ht-card-link-action p-0" id="linkBackToDashboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Client Dashboard</span>
        </a>
    </div>

    <!-- Page Header -->
    <div class="ht-trainer-header-row mb-4">
        <div>
            <h1 class="ht-welcome-title">Trainer Feedback</h1>
            <p class="ht-welcome-subtitle">Personalized advice, routine modifications, and encouragement from your trainer.</p>
        </div>
        <div class="ht-trainer-actions-group">
            <span class="ht-status-badge ht-status-confirmed px-3 py-2" id="feedbackCountBadge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>@totalCount @(totalCount == 1 ? "Feedback Entry" : "Feedback Entries")</span>
            </span>
        </div>
    </div>

    @if (totalCount == 0)
    {
        <!-- Empty State -->
        <div class="ht-card text-center py-5 ht-feedback-empty-card" id="emptyFeedbackState">
            <div class="ht-feedback-empty-icon mb-3" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    <line x1="9" y1="10" x2="15" y2="10"></line>
                    <line x1="12" y1="7" x2="12" y2="13"></line>
                </svg>
            </div>
            <h2 class="h5 fw-bold text-dark mb-1">No Trainer Feedback Yet</h2>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                Your assigned trainer has not recorded any feedback yet. When your trainer reviews your workout routines, meal plans, or progress measurements, their feedback and coaching notes will appear here.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Client" asp-action="index" class="ht-btn-submit px-4 text-decoration-none">
                    <span>Return to Dashboard</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Feedback List -->
        <div class="ht-feedback-list d-flex flex-column gap-3" id="feedbackListContainer">
            @foreach (var item in feedbackList)
            {
                var trainerName = !string.IsNullOrWhiteSpace(item.trainer?.name) ? item.trainer.name : "Assigned Trainer";
                var trainerSpec = !string.IsNullOrWhiteSpace(item.trainer?.specialization) ? item.trainer.specialization : "Fitness Coach";
                var initials = "TR";
                if (!string.IsNullOrWhiteSpace(item.trainer?.name))
                {
                    var parts = item.trainer.name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length >= 2)
                    {
                        initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                    }
                    else if (parts.Length == 1 && parts[0].Length > 0)
                    {
                        initials = parts[0][0].ToString().ToUpper();
                    }
                }

                <article class="ht-card ht-feedback-card" id="feedback_@item.feedbackId">
                    <div class="ht-feedback-card-header d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ht-profile-avatar ht-feedback-avatar" aria-hidden="true">
                                @initials
                            </div>
                            <div>
                                <h2 class="ht-feedback-trainer-name mb-0">@trainerName</h2>
                                <span class="ht-feedback-trainer-spec">@trainerSpec</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="ht-feedback-date-badge text-muted">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <time datetime="@item.date.ToString("yyyy-MM-ddTHH:mm:ss")">@item.date.ToString("MMM dd, yyyy · h:mm tt")</time>
                            </span>
                        </div>
                    </div>

                    <div class="ht-feedback-comment-box">
                        <p class="ht-feedback-comment-text mb-0">@item.comment</p>
                    </div>

                    <div class="ht-feedback-card-footer d-flex align-items-center justify-content-between mt-3 pt-2 text-muted small">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success" aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <span>Verified Trainer Feedback</span>
                        </div>
                        <span class="ht-feedback-id-tag">Reference #FB-@item.feedbackId</span>
                    </div>
                </article>
            }
        </div>
    }
</div>
