@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="ht-auth-canvas">
    <div class="ht-auth-card">
        <!-- Category & Title -->
        <div class="ht-card-header">
            <span class="ht-category-tag">NEW ACCOUNT</span>
            <h1 class="ht-card-title">Create an Account</h1>
            <p class="ht-card-subtitle">Get started with your personal health and fitness portal</p>
        </div>

        <!-- Server-side Model Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>

        <!-- Registration Form -->
        <form asp-controller="Account" asp-action="register" method="post" class="ht-form" id="registerForm" novalidate>
            @Html.AntiForgeryToken()

            <!-- Hidden Role defaulting to Client per backend contract and specification -->
            <input type="hidden" asp-for="role" value="Client" />

            <!-- Full Name Field -->
            <div class="ht-form-group">
                <label asp-for="name" class="ht-label">Full Name</label>
                <div class="ht-input-box">
                    <span class="ht-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </span>
                    <input asp-for="name"
                           type="text"
                           class="ht-input"
                           placeholder="e.g. Alex Morgan"
                           autocomplete="name"
                           aria-required="true"
                           id="register-name" />
                </div>
                <span asp-validation-for="name" class="ht-field-validation"></span>
            </div>

            <!-- Email Address Field -->
            <div class="ht-form-group">
                <label asp-for="email" class="ht-label">Email Address</label>
                <div class="ht-input-box">
                    <span class="ht-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <input asp-for="email"
                           type="email"
                           class="ht-input"
                           placeholder="alex@example.com"
                           autocomplete="email"
                           aria-required="true"
                           id="register-email" />
                </div>
                <span asp-validation-for="email" class="ht-field-validation"></span>
            </div>

            <!-- Password Field -->
            <div class="ht-form-group">
                <label asp-for="password" class="ht-label">Password</label>
                <div class="ht-input-box">
                    <span class="ht-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <input asp-for="password"
                           type="password"
                           class="ht-input ht-input-pwd"
                           placeholder="Create a strong password"
                           autocomplete="new-password"
                           aria-required="true"
                           id="register-password" />
                    <button type="button"
                            class="ht-pwd-toggle"
                            aria-label="Toggle password visibility"
                            tabindex="-1">
                        <svg class="icon-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="icon-eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                            <line x1="2" x2="22" y1="2" y2="22"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="password" class="ht-field-validation"></span>

                <!-- Password Requirements Hints matching reference -->
                <div class="ht-pwd-guidance">
                    <span class="ht-guidance-item" id="rule-length">
                        <svg class="ht-rule-dot" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                        </svg>
                        <span>8+ characters</span>
                    </span>
                    <span class="ht-guidance-item" id="rule-combo">
                        <svg class="ht-rule-dot" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                        </svg>
                        <span>Letter &amp; number</span>
                    </span>
                </div>
            </div>

            <!-- Confirm Password Field -->
            <div class="ht-form-group">
                <label asp-for="confirmPassword" class="ht-label">Confirm Password</label>
                <div class="ht-input-box">
                    <span class="ht-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                            <path d="M3 3v5h5"></path>
                        </svg>
                    </span>
                    <input asp-for="confirmPassword"
                           type="password"
                           class="ht-input ht-input-pwd"
                           placeholder="Re-enter password"
                           autocomplete="new-password"
                           aria-required="true"
                           id="register-confirmPassword" />
                    <button type="button"
                            class="ht-pwd-toggle"
                            aria-label="Toggle password visibility"
                            tabindex="-1">
                        <svg class="icon-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="icon-eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                            <line x1="2" x2="22" y1="2" y2="22"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="confirmPassword" class="ht-field-validation"></span>
            </div>

            <!-- Informational Terms & Privacy Checkbox -->
            <div class="ht-checkbox-box ht-terms-box">
                <input type="checkbox" id="termsConsent" class="ht-checkbox" />
                <label for="termsConsent" class="ht-checkbox-label">
                    I agree to the <a asp-controller="Home" asp-action="Privacy" class="ht-link-teal">Terms of Service</a> and <a asp-controller="Home" asp-action="Privacy" class="ht-link-teal">Privacy Policy</a>
                </label>
            </div>

            <!-- Primary Create Account Button -->
            <button type="submit" class="ht-btn-submit" id="registerSubmitBtn">
                <span>Create Account</span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Card Footer Navigation -->
        <div class="ht-card-switch">
            <span>Already have an account?</span>
            <a asp-controller="Account" asp-action="login" class="ht-link-teal ht-fw-bold" id="linkToLogin">Sign In</a>
        </div>

        <!-- Administrator Notice Box matching reference -->
        <div class="ht-admin-notice-box">
            <span class="ht-admin-notice-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </span>
            <span>Administrator accounts are provisioned via institutional backend governance.</span>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
