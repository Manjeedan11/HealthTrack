@model HealthTrack.Models.TrainerDashboardViewModel
@{
    Layout = "_TrainerLayout";
    ViewData["Title"] = "Trainer Dashboard";
    ViewData["TrainerName"] = Model.TrainerName;
    ViewData["TrainerInitials"] = Model.Initials;
}

<div class="ht-dashboard-container">
    @if (Model.IsDemonstrationData)
    {
        <div class="ht-demo-notice alert alert-info d-flex align-items-center mb-4" role="alert">
            <svg class="me-2 flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <div class="small">
                <strong>Demonstration Preview:</strong> Displaying representative trainer data matching the coursework specification. Live records will populate automatically upon configuring the database connection.
            </div>
        </div>
    }

    <!-- Top Header & Quick Actions Row -->
    <div class="ht-trainer-header-row mb-4">
        <!-- Welcome Heading on the Left -->
        <div class="ht-welcome-section">
            <h1 class="ht-welcome-title">
                Welcome back,<br />@Model.FirstName
            </h1>
            <p class="ht-welcome-subtitle">Here's your client and appointment overview.</p>
        </div>

        <!-- Action Cards on the Right matching attached screenshot -->
        <div class="ht-trainer-actions-group" role="toolbar" aria-label="Trainer Quick Actions">
            <!-- Create / Assign Workout -->
            <a asp-controller="Workout" asp-action="create" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span class="ht-action-card-text">Create / Assign<br />Workout</span>
            </a>

            <!-- Create / Assign Diet -->
            <a asp-controller="Diet" asp-action="create" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span class="ht-action-card-text">Create / Assign<br />Diet</span>
            </a>

            <!-- Provide Feedback -->
            <a asp-controller="Feedback" asp-action="give" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span>
                <span class="ht-action-card-text">Provide<br />Feedback</span>
            </a>
        </div>
    </div>

    <!-- Main Dashboard Two-Column Grid -->
    <div class="row g-4">
        <!-- Left Column: Assigned Clients & Client Progress Summary -->
        <div class="col-12 col-lg-7 col-xl-7 d-flex flex-column gap-4">
            <!-- Card 1: Assigned Clients & Progress -->
            <section class="ht-card" id="clients-roster" aria-labelledby="headingAssignedClients">
                <div class="ht-card-header-flex">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0" id="headingAssignedClients">Assigned Clients &amp; Progress</h2>
                            <p class="ht-card-subtitle mb-0">Active roster and direct profile access</p>
                        </div>
                    </div>
                    <a href="#clients-roster" class="ht-card-link-action">
                        <span>View All Clients</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <!-- Clients Table / Roster -->
                <div class="table-responsive">
                    <table class="table ht-trainer-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="ht-th-col">CLIENT</th>
                                <th scope="col" class="ht-th-col">PROGRESS</th>
                                <th scope="col" class="ht-th-col text-end">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssignedClients.Any())
                            {
                                @foreach (var client in Model.AssignedClients)
                                {
                                    <tr class="ht-client-row">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="ht-client-avatar">
                                                    @client.Initials
                                                </div>
                                                <div class="d-flex flex-column">
                                                    <span class="ht-client-name">@client.Name</span>
                                                    <span class="ht-client-id">ID: @client.DisplayId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="ht-client-progress-text">
                                                <span class="ht-prog-label">Weight:</span>
                                                <strong class="ht-prog-val">@(client.LatestWeight.HasValue ? $"{client.LatestWeight:F1} {client.WeightUnit}" : "—")</strong>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Workout" asp-action="index" asp-route-clientId="@client.ClientId" class="ht-view-details-link">
                                                <span>View Details</span>
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    <polyline points="12 5 19 12 12 19"></polyline>
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">
                                        No clients currently assigned.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Card 2: Client Progress Summary -->
            <section class="ht-card" aria-labelledby="headingProgressSummary">
                <div class="ht-card-header-flex">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"></circle>
                                <line x1="12" y1="3" x2="12" y2="21"></line>
                                <line x1="8" y1="8" x2="16" y2="8"></line>
                                <line x1="7" y1="16" x2="17" y2="16"></line>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0" id="headingProgressSummary">Client Progress Summary</h2>
                            <p class="ht-card-subtitle mb-0">Recent weight log updates from assigned clients</p>
                        </div>
                    </div>
                    <a asp-controller="Trainer" asp-action="index" asp-fragment="clients-roster" class="ht-card-link-action">
                        <span>View Client Progress</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <!-- 3 Mini Cards in a Row -->
                <div class="ht-progress-summary-grid">
                    @if (Model.ProgressSummaries.Any())
                    {
                        @foreach (var summary in Model.ProgressSummaries)
                        {
                            <div class="ht-progress-summary-card">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="ht-summary-client-name">@summary.ClientFirstName</span>
                                    <div class="ht-summary-scale-icon" aria-hidden="true">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                                            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                                            <path d="M7 21h10"></path>
                                            <path d="M12 3v18"></path>
                                            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="ht-summary-weight">
                                    @summary.Weight.ToString("F1") <span class="ht-summary-unit">@summary.WeightUnit</span>
                                </div>
                                <div class="ht-summary-note">@summary.StatusNote</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted p-3">No recent progress entries logged yet.</div>
                    }
                </div>
            </section>
        </div>

        <!-- Right Column: Appointments -->
        <div class="col-12 col-lg-5 col-xl-5">
            <section class="ht-card h-100 d-flex flex-column" aria-labelledby="headingAppointments">
                <div class="ht-card-header-flex">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                                <line x1="16" x2="16" y1="2" y2="6"></line>
                                <line x1="8" y1="8" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0" id="headingAppointments">Appointments</h2>
                            <p class="ht-card-subtitle mb-0">Upcoming &amp; Pending</p>
                        </div>
                    </div>
                    <span class="ht-badge-total">@Model.TotalAppointments Total</span>
                </div>

                <!-- Appointment Items List -->
                <div class="ht-appointments-list flex-grow-1">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            <div class="ht-appointment-box mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="ht-appointment-time d-flex align-items-center gap-2">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>@appt.TimeFormatted</span>
                                    </div>
                                    @if (string.Equals(appt.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="ht-status-badge ht-status-confirmed">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="ht-status-badge ht-status-pending">Pending</span>
                                    }
                                </div>
                                <h3 class="ht-appointment-client-name mb-1">@appt.ClientName</h3>
                                <div class="ht-appointment-type">@appt.ServiceType</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            No appointments scheduled.
                        </div>
                    }
                </div>

                <!-- View Appointments Button at Bottom -->
                <div class="mt-3">
                    <a asp-controller="Appointment" asp-action="index" class="ht-btn-view-appointments">
                        <span>View Appointments</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>
