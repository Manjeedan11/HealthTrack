@model HealthTrack.ViewModels.Trainer.CreateWorkoutPlanViewModel
@{
    Layout = "_TrainerLayout";
    ViewData["Title"] = "Create / Assign Workout";
}

<div class="ht-dashboard-container">
    <!-- Breadcrumb & Back Link -->
    <div class="mb-3">
        <a asp-controller="Trainer" asp-action="routines" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Manage Routines</span>
        </a>
    </div>

    <!-- Page Header -->
    <div class="ht-welcome-section mb-4">
        <h1 class="ht-welcome-title">Create / Assign Workout</h1>
        <p class="ht-welcome-subtitle">Define workout plan specifications, select the target client, and schedule exercise routines.</p>
    </div>

    <!-- Main Form Card -->
    <div class="row g-4">
        <div class="col-12 col-xl-10">
            <div class="ht-card">
                <div class="ht-card-header-flex mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge ht-workout-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m6.5 6.5 11 11"></path>
                                <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-.88.88a2 2 0 0 1-2.83 0l-1.58-1.58a2 2 0 0 1 0-2.83l.88-.88a2 2 0 0 0 0-2.83L11.5 10.5"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0">Plan Configuration</h2>
                            <p class="ht-card-subtitle mb-0">Complete all required routine details and exercise targets</p>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="ht-validation-summary" role="alert"></div>

                <form asp-controller="Workout" asp-action="create" method="post" id="workoutCreateForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <!-- Workout Plan Name -->
                        <div class="col-12 col-md-7">
                            <div class="ht-form-group mb-0">
                                <label asp-for="WorkoutPlan.name" class="ht-label">Workout Plan Name <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m6.5 6.5 11 11"></path>
                                            <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-.88.88a2 2 0 0 1-2.83 0l-1.58-1.58a2 2 0 0 1 0-2.83l.88-.88a2 2 0 0 0 0-2.83L11.5 10.5"></path>
                                        </svg>
                                    </span>
                                    <input asp-for="WorkoutPlan.name"
                                           class="ht-input"
                                           placeholder="e.g., Upper Body Strength & Hypertrophy"
                                           required
                                           aria-required="true"
                                           id="plan-name-input" />
                                </div>
                                <span asp-validation-for="WorkoutPlan.name" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Client Assignment Selector -->
                        <div class="col-12 col-md-5">
                            <div class="ht-form-group mb-0">
                                <label asp-for="WorkoutPlan.clientId" class="ht-label">Assign To Client <span class="text-danger">*</span></label>
                                <div class="ht-input-box">
                                    <span class="ht-field-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                        </svg>
                                    </span>
                                    <select asp-for="WorkoutPlan.clientId" class="ht-input ht-select" id="plan-client-select" required>
                                        <option value="" disabled selected>-- Select an assigned client --</option>
                                        @if (Model.AvailableClients != null)
                                        {
                                            foreach (var client in Model.AvailableClients)
                                            {
                                                <option value="@client.clientId">@client.name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="WorkoutPlan.clientId" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Info Note -->
                        <div class="col-12">
                            <div class="ht-workout-notice d-flex align-items-center gap-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-primary">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span class="small text-muted">
                                    <strong>Client Roster:</strong> Only clients assigned to you by the Administrator appear here.
                                </span>
                            </div>
                        </div>

                        <!-- Plan Description -->
                        <div class="col-12">
                            <div class="ht-form-group mb-0">
                                <label asp-for="WorkoutPlan.description" class="ht-label">Routine Description & Instructions</label>
                                <textarea asp-for="WorkoutPlan.description"
                                          class="form-control ht-workout-textarea"
                                          rows="3"
                                          placeholder="Provide warm-up recommendations, rest periods, coaching cues and progression instructions..."
                                          id="plan-description-input"></textarea>
                                <span asp-validation-for="WorkoutPlan.description" class="ht-field-validation"></span>
                            </div>
                        </div>

                        <!-- Trainer Identity -->
                        <div class="col-12">
                            <div class="ht-workout-trainer-badge-card">
                                <div class="ht-profile-avatar">
                                    @(ViewData["TrainerInitials"] ?? "TR")
                                </div>
                                <div class="d-flex flex-column">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="ht-client-name">@(ViewData["TrainerName"] ?? "Trainer Account")</span>
                                        <span class="ht-status-badge ht-status-confirmed py-0 px-2" style="font-size: 0.68rem;">Verified Trainer</span>
                                    </div>
                                    <span class="ht-workout-trainer-caption">Assigned Trainer Account · ID linked to authenticated identity</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Exercises Builder -->
                    <div class="ht-workout-builder-section mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div>
                                <h3 class="ht-card-heading mb-1">Exercise Regimen</h3>
                                <p class="text-muted small mb-0">Define exercises with designated sets, repetitions, and durations.</p>
                            </div>
                            <button type="button" class="ht-action-btn" id="btnAddExerciseRow" aria-label="Add another exercise row">
                                <span class="ht-action-icon" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </span>
                                <span>+ Add Exercise</span>
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table ht-trainer-table align-middle mb-0" id="exercisesTable">
                                <thead>
                                    <tr>
                                        <th scope="col" class="ht-th-col" style="width: 42%;">EXERCISE NAME <span class="text-danger">*</span></th>
                                        <th scope="col" class="ht-th-col" style="width: 18%;">SETS <span class="text-danger">*</span></th>
                                        <th scope="col" class="ht-th-col" style="width: 18%;">REPS <span class="text-danger">*</span></th>
                                        <th scope="col" class="ht-th-col" style="width: 16%;">DURATION (MIN)</th>
                                        <th scope="col" class="ht-th-col text-end" style="width: 6%;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody id="exerciseRowsContainer">
                                    <tr class="ht-workout-builder-row" data-row-index="0">
                                        <td>
                                            <input type="text"
                                                   name="WorkoutPlan.exercises[0].name"
                                                   class="form-control ht-workout-table-input"
                                                   placeholder="e.g., Barbell Bench Press"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="WorkoutPlan.exercises[0].sets"
                                                   class="form-control ht-workout-table-input"
                                                   placeholder="4"
                                                   min="1"
                                                   value="3"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="WorkoutPlan.exercises[0].reps"
                                                   class="form-control ht-workout-table-input"
                                                   placeholder="10"
                                                   min="1"
                                                   value="10"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="WorkoutPlan.exercises[0].duration"
                                                   class="form-control ht-workout-table-input"
                                                   placeholder="2"
                                                   min="0"
                                                   value="0" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm ht-workout-btn-remove btnRemoveRow"
                                                    disabled
                                                    title="At least one exercise row is required">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4 pt-3 border-top">
                        <a asp-controller="Trainer" asp-action="routines" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        <button type="submit" class="ht-btn-submit px-4">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Create Workout Plan</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';
            const container = document.getElementById('exerciseRowsContainer');
            const addBtn = document.getElementById('btnAddExerciseRow');

            function updateRowIndices() {
                const rows = container.querySelectorAll('.ht-workout-builder-row');
                rows.forEach((row, index) => {
                    row.setAttribute('data-row-index', index);
                    const nameInput = row.querySelector('input[name$=".name"]');
                    const setsInput = row.querySelector('input[name$=".sets"]');
                    const repsInput = row.querySelector('input[name$=".reps"]');
                    const durInput = row.querySelector('input[name$=".duration"]');
                    const removeBtn = row.querySelector('.btnRemoveRow');

                    if (nameInput) nameInput.name = `WorkoutPlan.exercises[${index}].name`;
                    if (setsInput) setsInput.name = `WorkoutPlan.exercises[${index}].sets`;
                    if (repsInput) repsInput.name = `WorkoutPlan.exercises[${index}].reps`;
                    if (durInput) durInput.name = `WorkoutPlan.exercises[${index}].duration`;

                    if (removeBtn) {
                        removeBtn.disabled = rows.length === 1;
                        removeBtn.title = rows.length === 1 ? "At least one exercise row is required" : "Remove this exercise";
                    }
                });
            }

            if (addBtn && container) {
                addBtn.addEventListener('click', function () {
                    const newIndex = container.querySelectorAll('.ht-workout-builder-row').length;
                    const tr = document.createElement('tr');
                    tr.className = 'ht-workout-builder-row';
                    tr.setAttribute('data-row-index', newIndex);
                    tr.innerHTML = `
                        <td>
                            <input type="text" name="WorkoutPlan.exercises[${newIndex}].name" class="form-control ht-workout-table-input" placeholder="e.g., Dumbbell Lateral Raise" required />
                        </td>
                        <td>
                            <input type="number" name="WorkoutPlan.exercises[${newIndex}].sets" class="form-control ht-workout-table-input" min="1" value="3" required />
                        </td>
                        <td>
                            <input type="number" name="WorkoutPlan.exercises[${newIndex}].reps" class="form-control ht-workout-table-input" min="1" value="12" required />
                        </td>
                        <td>
                            <input type="number" name="WorkoutPlan.exercises[${newIndex}].duration" class="form-control ht-workout-table-input" min="0" value="0" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm ht-workout-btn-remove btnRemoveRow">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </td>`;
                    container.appendChild(tr);
                    updateRowIndices();
                    tr.querySelector('input').focus();
                });

                container.addEventListener('click', function (e) {
                    const removeBtn = e.target.closest('.btnRemoveRow');
                    if (!removeBtn) return;
                    const rows = container.querySelectorAll('.ht-workout-builder-row');
                    if (rows.length <= 1) return;
                    removeBtn.closest('.ht-workout-builder-row').remove();
                    updateRowIndices();
                });
            }

            updateRowIndices();
        })();
    </script>
}