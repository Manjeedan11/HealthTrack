@model AssignedClientItem

<div class="ht-dashboard-container">
    <!-- Breadcrumb & Back Navigation -->
    <div class="d-flex align-items-center gap-3 mb-3">
        <a asp-controller="Trainer" asp-action="index" asp-route-screen="clients" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Clients</span>
        </a>
        <span class="text-muted" aria-hidden="true">•</span>
        <a asp-controller="Trainer" asp-action="index" class="ht-card-link-action p-0">
            <span>Back to Trainer Dashboard</span>
        </a>
    </div>

    <!-- Client Profile Header Banner -->
    <section class="ht-card mb-4" aria-labelledby="clientHeaderTitle">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="ht-client-avatar-lg" aria-hidden="true">
                    @Model.Initials
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="ht-welcome-title mb-0" id="clientHeaderTitle">@Model.Name</h1>
                        <span class="ht-status-badge ht-status-confirmed">Active Client</span>
                    </div>
                    <p class="ht-card-subtitle mb-0 mt-1">Client Identifier: <strong class="text-dark">@Model.DisplayId</strong></p>
                </div>
            </div>

            <!-- Quick Action Shortcuts -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Feedback" asp-action="give" asp-route-clientId="@Model.ClientId" class="ht-action-card-btn py-2 px-3">
                    <span class="ht-action-card-icon" style="width:26px; height:26px;" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </span>
                    <span class="ht-action-card-text" style="font-size:0.8rem;">Give Feedback</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Two-Column Overview Grid -->
    <div class="row g-4 mb-4">
        <!-- Left Column: Health Metrics & Recorded Progress -->
        <div class="col-12 col-lg-6">
            <section class="ht-card h-100 d-flex flex-column" aria-labelledby="headingLatestProgress">
                <div class="ht-card-header-flex">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"></circle>
                                <line x1="12" y1="3" x2="12" y2="21"></line>
                                <line x1="8" y1="8" x2="16" y2="8"></line>
                                <line x1="7" y1="16" x2="17" y2="16"></line>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0" id="headingLatestProgress">Latest Health Metric</h2>
                            <p class="ht-card-subtitle mb-0">Most recently recorded progress measurement</p>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1">
                    @if (Model.LatestWeight.HasValue)
                    {
                        <div class="ht-progress-summary-card mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="ht-summary-client-name">Recorded Body Weight</span>
                                <div class="ht-summary-scale-icon" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                                        <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                                        <path d="M7 21h10"></path>
                                        <path d="M12 3v18"></path>
                                        <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="ht-summary-weight">
                                @Model.LatestWeight.Value.ToString("F1") <span class="ht-summary-unit">@Model.WeightUnit</span>
                            </div>
                            <div class="ht-summary-note">Latest recorded weight measurement on file</div>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 rounded-3 border border-dashed bg-light text-center mb-3">
                            <div class="ht-workout-empty-icon mx-auto mb-2" style="width:48px; height:48px;" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="8" y1="12" x2="16" y2="12"></line>
                                </svg>
                            </div>
                            <div class="fw-semibold text-dark">No latest weight recorded</div>
                            <div class="small text-muted mt-1">This client has not logged any body weight measurements yet.</div>
                        </div>
                    }

                    <div class="ht-workout-notice mt-auto">
                        <div class="small text-muted">
                            <strong>Data Governance Note:</strong> Additional biometric details (such as height, BMI trends, and individual consultations) are recorded and maintained through the client's self-tracking portal and administrative records.
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Right Column: Client Management Actions & Routines -->
        <div class="col-12 col-lg-6">
            <section class="ht-card h-100 d-flex flex-column" aria-labelledby="headingClientManagement">
                <div class="ht-card-header-flex">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ht-header-icon-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <div>
                            <h2 class="ht-card-title mb-0" id="headingClientManagement">Client Management</h2>
                            <p class="ht-card-subtitle mb-0">Manage routines, diet plans and feedback for @Model.Name</p>
                        </div>
                    </div>
                </div>

                <!-- Navigation to existing features -->
                <div class="d-flex flex-column gap-3 flex-grow-1">
                    <!-- 1. View Workout Plans -->
                    <a asp-controller="Workout" asp-action="index" asp-route-clientId="@Model.ClientId" class="ht-client-overview-action">
                        <div class="d-flex align-items-center gap-3">
                            <span class="ht-action-card-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6.5 6.5 11 11"></path>
                                    <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-.88.88a2 2 0 0 1-2.83 0l-1.58-1.58a2 2 0 0 1 0-2.83l.88-.88a2 2 0 0 0 0-2.83L11.5 10.5"></path>
                                    <path d="m3 3 1 1a2 2 0 0 0 2.83 0l.88-.88a2 2 0 0 1 2.83 0l1.58 1.58a2 2 0 0 1 0 2.83l-.88.88a2 2 0 0 0 0 2.83l2.25 2.25"></path>
                                </svg>
                            </span>
                            <div>
                                <div class="fw-bold text-dark">View Workout Plans</div>
                                <div class="small text-muted">Review exercises and routines assigned to this client</div>
                            </div>
                        </div>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>

                    <!-- 2. View Diet Plans -->
                    <a asp-controller="Diet" asp-action="index" asp-route-clientId="@Model.ClientId" class="ht-client-overview-action">
                        <div class="d-flex align-items-center gap-3">
                            <span class="ht-action-card-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 2v20"></path>
                                    <path d="M18 2a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4"></path>
                                    <path d="M6 2v6a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2"></path>
                                    <path d="M8 10v12"></path>
                                </svg>
                            </span>
                            <div>
                                <div class="fw-bold text-dark">View Diet Plans</div>
                                <div class="small text-muted">Check nutrition schedules and meal allocations</div>
                            </div>
                        </div>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>

                    <!-- 3. Provide Feedback -->
                    <a asp-controller="Feedback" asp-action="give" asp-route-clientId="@Model.ClientId" class="ht-client-overview-action">
                        <div class="d-flex align-items-center gap-3">
                            <span class="ht-action-card-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <div>
                                <div class="fw-bold text-dark">Provide Trainer Feedback</div>
                                <div class="small text-muted">Submit motivational notes and routine adjustments</div>
                            </div>
                        </div>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </section>
        </div>
    </div>

    <!-- Return Actions Footer -->
    <div class="d-flex align-items-center gap-3">
        <a asp-controller="Trainer" asp-action="index" asp-route-screen="clients" class="ht-action-card-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Return to Clients Directory</span>
        </a>
        <a asp-controller="Trainer" asp-action="index" class="ht-action-card-btn">
            <span>Back to Dashboard</span>
        </a>
    </div>
</div>
