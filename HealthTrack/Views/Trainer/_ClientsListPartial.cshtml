@model TrainerDashboardViewModel

<div class="ht-dashboard-container">
    <!-- Breadcrumb & Back Navigation -->
    <div class="mb-3">
        <a asp-controller="Trainer" asp-action="index" class="ht-card-link-action p-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Trainer Dashboard</span>
        </a>
    </div>

    <!-- Page Header & Action Buttons Row -->
    <div class="ht-trainer-header-row mb-4">
        <div class="ht-welcome-section">
            <h1 class="ht-welcome-title">Clients Directory</h1>
            <p class="ht-welcome-subtitle">Review registered clients, check latest weight recordings, and access individual client profiles.</p>
        </div>

        <!-- Quick Actions Toolbar -->
        <div class="ht-trainer-actions-group" role="toolbar" aria-label="Trainer Quick Actions">
            <a asp-controller="Workout" asp-action="create" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span class="ht-action-card-text">Create / Assign<br />Workout</span>
            </a>

            <a asp-controller="Diet" asp-action="create" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span class="ht-action-card-text">Create / Assign<br />Diet</span>
            </a>

            <a asp-controller="Feedback" asp-action="give" class="ht-action-card-btn">
                <span class="ht-action-card-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span>
                <span class="ht-action-card-text">Provide<br />Feedback</span>
            </a>
        </div>
    </div>

    <!-- Main Clients Card -->
    <section class="ht-card" aria-labelledby="headingClientsDirectory">
        <div class="ht-card-header-flex">
            <div class="d-flex align-items-center gap-3">
                <div class="ht-header-icon-badge" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="ht-card-title mb-0" id="headingClientsDirectory">All Registered Clients</h2>
                    <p class="ht-card-subtitle mb-0">Select any client to view their individual overview, routines and feedback</p>
                </div>
            </div>
            <span class="ht-badge-total">@Model.AssignedClients.Count Total Clients</span>
        </div>

        <!-- Clients Table -->
        <div class="table-responsive">
            <table class="table ht-trainer-table align-middle mb-0" aria-label="Clients Directory Table">
                <thead>
                    <tr>
                        <th scope="col" class="ht-th-col">CLIENT</th>
                        <th scope="col" class="ht-th-col">LATEST WEIGHT</th>
                        <th scope="col" class="ht-th-col text-end">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AssignedClients.Any())
                    {
                        @foreach (var client in Model.AssignedClients)
                        {
                            <tr class="ht-client-row">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="ht-client-avatar" aria-hidden="true">
                                            @client.Initials
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="ht-client-name">@client.Name</span>
                                            <span class="ht-client-id">ID: @client.DisplayId</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="ht-client-progress-text">
                                        @if (client.LatestWeight.HasValue)
                                        {
                                            <span class="ht-prog-label">Weight:</span>
                                            <strong class="ht-prog-val">@($"{client.LatestWeight:F1} {client.WeightUnit}")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No latest weight recorded</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Trainer" asp-action="index" asp-route-screen="client" asp-route-clientId="@client.ClientId" class="ht-view-details-link">
                                        <span>View Client</span>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                            <polyline points="12 5 19 12 12 19"></polyline>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <div class="ht-workout-empty-icon mx-auto mb-3" aria-hidden="true">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                    </svg>
                                </div>
                                <div class="fw-semibold">No clients currently found.</div>
                                <div class="small mt-1">Client accounts will appear here once registered in the system.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
